@@ -0,0 +1,1380 @@
+//! Replay of the length-framed depth spill (`.ilpf`, plan item 49d-1,
+//! 2026-10-06).
+//!
+//! Runs in the depth directory's replay round, after the text pass
+//! (`tick_spill_replay::replay_spill_dir`), on the same blocking-pool thread,
+//! held 08:00-15:40 IST with it.
+//!
+//! # How a file is read
+//!
+//! 1. **Snapshot under the append lock.** The file's length is read while no
+//!    append can be in flight, so every byte inside it is a finished write or
+//!    a stable crash leftover, and every judgement inside it is final.
+//! 2. **Stream from the resume offset** (a record boundary) through one fixed
+//!    window, judging each position with
+//!    `depth_spill_frame::FramedCursor`: a whole CRC-checked record, corrupt
+//!    bytes up to the next possible record, or a torn tail at the end.
+//! 3. **Records.** Kind 1 for `market_depth` is filtered on the arrival clock
+//!    exactly like the text spill and POSTed. A permanent refusal isolates the
+//!    refused lines (the text path's own bisection). A record QuestDB refuses
+//!    WHOLE (no single line explains it, or every line is refused) is set
+//!    aside on its own and the replay carries on; only
+//!    `FRAMED_REFUSED_WHOLE_IN_A_ROW_QUARANTINE` such records in a row move
+//!    the whole file to quarantine (finding 2026-10-06: one framed record is
+//!    one rescue batch, often a single row, so letting the first refused
+//!    record decide the file's fate quarantined hours of good rows that the
+//!    8 MiB text chunks would have drained). Kind 2, or a kind-1
+//!    record for any other table, is never posted in this step: it is set
+//!    aside, byte for byte.
+//! 4. **Set-asides** go to `quarantine/<file><suffix>` and are synced before
+//!    the reader moves past them: `.corrupt-bytes`, `.torn-tail`,
+//!    `.unsupported-records`, `.refused-records`. The quarantine trim deletes nothing without a
+//!    verified cold copy.
+//! 5. **End of the snapshot.** Under the lock: if the file did not grow it is
+//!    removed (a drained framed file is never left behind); if it grew, the
+//!    offset is remembered and the next round starts there.
+//!
+//! A transient failure (QuestDB down, a read error, a set-aside that could
+//! not be written) remembers the start of the failing record and stops the
+//! round, as the text path does. Nothing already consumed is read again in
+//! this process; a restart re-posts from the start, which the depth dedup key
+//! (`depth_kind`, `capture_seq`) makes idempotent.
+//!
+//! # Complexity
+//!
+//! O(file bytes) per round; a resync adds O(scanned bytes) plus one CRC per
+//! candidate. Peak memory: one `REPLAY_STREAM_BUFFER_BYTES` window per round,
+//! allocated only when a framed file exists. Cold path: the replay task's
+//! blocking thread, never the frame drain.
+
+use std::io::{Seek as _, Write as _};
+use std::path::Path;
+
+use reqwest::Client;
+use tickvault_common::error_code::ErrorCode;
+use tracing::{error, info, warn};
+
+use crate::depth_spill_frame::{
+    FRAME_HEADER_BYTES, FRAME_KIND_ILP_V1_LINES, FRAME_SET_ASIDE_BYTES_COUNTER, FrameHeader,
+    FramedCursor, SpanKind, append_lock, list_framed_spill_files, register_frame_baseline,
+};
+use crate::tick_spill_replay::{
+    LineIsolation, QUARANTINE_DIR, REPLAY_LINES_REJECTED_COUNTER, REPLAY_QUARANTINED_COUNTER,
+    REPLAY_STREAM_BUFFER_BYTES, SpillReplayOutcome, describe_send_error, dir_label,
+    forget_resume_offset, is_permanent_refusal, isolate_refused_lines, quarantine_spill_file,
+    record_resume_offset, resume_offset_for, retain_lines_in_open_window, set_aside_rejected_lines,
+};
+
+/// Why bytes of a framed file were set aside instead of posted.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum SetAside {
+    /// No record start in them (bit rot, a failed cut-back).
+    Corrupt,
+    /// The end of the locked snapshot, holding no record start (a crash
+    /// mid-append).
+    TornTail,
+    /// A record of a kind this step does not post (kind 2, ILP V2).
+    Unsupported,
+    /// A kind-1 record for a table other than `market_depth`.
+    WrongTable,
+    /// A kind-1 record QuestDB refused whole, fewer than
+    /// [`FRAMED_REFUSED_WHOLE_IN_A_ROW_QUARANTINE`] in a row.
+    Refused,
+}
+
+/// Records refused WHOLE in a row (none accepted in between) at which the
+/// whole file goes to quarantine instead of that record being set aside on
+/// its own. Three, so a table-level refusal (every record refused) still
+/// stops the file quickly, while one bad batch never takes the good records
+/// after it along. The records already set aside are inside the quarantined
+/// file too (kept twice, never lost).
+pub const FRAMED_REFUSED_WHOLE_IN_A_ROW_QUARANTINE: u32 = 3;
+
+impl SetAside {
+    fn reason(self) -> &'static str {
+        match self {
+            Self::Corrupt => "corrupt",
+            Self::TornTail => "torn_tail",
+            Self::Unsupported => "unsupported",
+            Self::WrongTable => "wrong_table",
+            Self::Refused => "refused",
+        }
+    }
+
+    fn source(self) -> &'static str {
+        match self {
+            Self::Corrupt => "depth_framed_corrupt",
+            Self::TornTail => "depth_framed_torn_tail",
+            Self::Unsupported => "depth_framed_unsupported",
+            Self::WrongTable => "depth_framed_wrong_table",
+            Self::Refused => "depth_framed_record_refused",
+        }
+    }
+
+    fn suffix(self) -> &'static str {
+        match self {
+            Self::Corrupt => ".corrupt-bytes",
+            Self::TornTail => ".torn-tail",
+            Self::Unsupported | Self::WrongTable => ".unsupported-records",
+            Self::Refused => ".refused-records",
+        }
+    }
+}
+
+/// How one file ended.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum FileEnd {
+    /// Go on to the next file.
+    Next,
+    /// Stop the round (QuestDB or the disk is unhappy).
+    StopRound,
+}
+
+/// What one file's replay has seen so far, carried from record to record.
+struct FileProgress {
+    /// Some row of this file reached QuestDB (or an earlier round consumed
+    /// part of it), so a single refused line is set aside, not the file.
+    any_accepted: bool,
+    /// Records refused whole since the last accepted one; at
+    /// [`FRAMED_REFUSED_WHOLE_IN_A_ROW_QUARANTINE`] the file is quarantined.
+    refused_whole_in_a_row: u32,
+}
+
+/// How one record ended.
+enum RecordEnd {
+    /// Posted, filtered out, isolated or set aside: move past it.
+    Done,
+    /// Transient: remember this record's start and stop the round.
+    Retry(&'static str, String),
+    /// The whole file was moved to quarantine.
+    FileQuarantined,
+}
+
+/// Replays every framed depth spill file in `dir` (see the module header).
+pub async fn replay_framed_spill_dir(dir: &Path, url: &str, client: &Client) -> SpillReplayOutcome {
+    let mut outcome = SpillReplayOutcome::default();
+    metrics::counter!(REPLAY_LINES_REJECTED_COUNTER, "dir" => dir_label(dir)).increment(0);
+    metrics::counter!(
+        "tv_spill_replay_rows_out_of_window_refused_total",
+        "dir" => dir_label(dir)
+    )
+    .increment(0);
+    register_frame_baseline();
+    let files = list_framed_spill_files(dir);
+    if files.is_empty() {
+        return outcome;
+    }
+    // ONE window per round, reused across files (the text pass's discipline).
+    let mut window = vec![0_u8; REPLAY_STREAM_BUFFER_BYTES]; // APPROVED: cold replay round, one buffer per round
+    // O(1) EXEMPT: begin — cold replay round over the directory's framed files.
+    for path in files {
+        let end = replay_one_framed_file(dir, &path, url, client, &mut window, &mut outcome).await;
+        if end == FileEnd::StopRound {
+            break;
+        }
+    }
+    // O(1) EXEMPT: end
+    outcome
+}
+
+async fn replay_one_framed_file(
+    dir: &Path,
+    path: &Path,
+    url: &str,
+    client: &Client,
+    window: &mut [u8],
+    outcome: &mut SpillReplayOutcome,
+) -> FileEnd {
+    // 1. Snapshot under the append lock.
+    let snapshot = {
+        let _guard = append_lock();
+        std::fs::metadata(path).map(|m| m.len())
+    };
+    let file_len = match snapshot {
+        Ok(len) => len,
+        Err(err) => return stop_round(outcome, path, None, "stat", &err),
+    };
+    if file_len == 0 {
+        remove_if_still_empty(path);
+        outcome.files_skipped_empty = outcome.files_skipped_empty.saturating_add(1);
+        return FileEnd::Next;
+    }
+    let resume = resume_offset_for(path).min(file_len);
+    let mut progress = FileProgress {
+        any_accepted: resume > 0,
+        refused_whole_in_a_row: 0,
+    };
+    if resume < file_len {
+        let mut file = match std::fs::File::open(path) {
+            Ok(f) => f,
+            Err(err) => return stop_round(outcome, path, Some(resume), "open", &err),
+        };
+        if resume > 0
+            && let Err(err) = file.seek(std::io::SeekFrom::Start(resume))
+        {
+            return stop_round(outcome, path, Some(resume), "seek", &err);
+        }
+        let mut cursor = FramedCursor::new(file, resume, file_len, window);
+        // O(1) EXEMPT: begin — cold replay, one pass over the snapshot.
+        loop {
+            let span = match cursor.next_span() {
+                Ok(Some(span)) => span,
+                Ok(None) => break,
+                Err(err) => {
+                    let at = cursor.position();
+                    return stop_round(outcome, path, Some(at), "read", &err);
+                }
+            };
+            let bytes = &cursor.window()[span.range.clone()];
+            let set_aside_as = match span.kind {
+                SpanKind::Record(header) => {
+                    match handle_record(
+                        dir,
+                        path,
+                        url,
+                        client,
+                        header,
+                        bytes,
+                        &mut progress,
+                        outcome,
+                    )
+                    .await
+                    {
+                        RecordEnd::Done => None,
+                        RecordEnd::Retry(stage, why) => {
+                            return stop_round(outcome, path, Some(span.offset), stage, &why);
+                        }
+                        RecordEnd::FileQuarantined => return FileEnd::Next,
+                    }
+                }
+                SpanKind::Corrupt => Some(SetAside::Corrupt),
+                SpanKind::TornTail => Some(SetAside::TornTail),
+            };
+            if let Some(kind) = set_aside_as
+                && let Err(err) = set_aside(dir, path, kind, bytes, rows_in_span(bytes), outcome)
+            {
+                return stop_round(outcome, path, Some(span.offset), "set_aside", &err);
+            }
+            cursor.consume(&span);
+        }
+        // O(1) EXEMPT: end
+    }
+    finish_framed_file(path, file_len, outcome)
+}
+
+/// Handles one whole, CRC-checked record (header included in `bytes`).
+async fn handle_record(
+    dir: &Path,
+    path: &Path,
+    url: &str,
+    client: &Client,
+    header: FrameHeader,
+    bytes: &[u8],
+    progress: &mut FileProgress,
+    outcome: &mut SpillReplayOutcome,
+) -> RecordEnd {
+    let payload = &bytes[FRAME_HEADER_BYTES..];
+    let rows = u64::from(header.rows.max(1));
+    if header.kind != FRAME_KIND_ILP_V1_LINES {
+        return set_aside_record(dir, path, SetAside::Unsupported, bytes, rows, outcome);
+    }
+    if !is_market_depth_payload(payload) {
+        return set_aside_record(dir, path, SetAside::WrongTable, bytes, rows, outcome);
+    }
+    // The depth spill is ARRIVAL-clocked; same filter, same clock, as the
+    // text spill (`replay_spill_dir`).
+    let (kept, refused_lines) = retain_lines_in_open_window(payload, true);
+    if refused_lines > 0 {
+        metrics::counter!(
+            "tv_spill_replay_rows_out_of_window_refused_total",
+            "dir" => dir_label(dir)
+        )
+        .increment(refused_lines);
+        warn!(
+            code = ErrorCode::StorageGapTickDedupSegment.code_str(),
+            source = "depth_framed_out_of_window",
+            refused_lines,
+            path = %path.display(),
+            "framed depth spill replay REFUSED lines whose arrival timestamp is a plausible \
+             epoch outside every open window -- the same refusal the depth writer makes. Not \
+             loss: the writer would have refused these rows too."
+        );
+    }
+    if kept.is_empty() {
+        return RecordEnd::Done;
+    }
+    let sent = bytes::Bytes::from(kept);
+    match client.post(url).body(sent.clone()).send().await {
+        Ok(resp) if resp.status().is_success() => {
+            progress.any_accepted = true;
+            progress.refused_whole_in_a_row = 0;
+            note_replayed(outcome, sent.len() as u64);
+            RecordEnd::Done
+        }
+        Ok(resp) if is_permanent_refusal(resp.status().as_u16()) => {
+            let status = resp.status().as_u16();
+            match isolate_refused_lines(client, url, &sent, progress.any_accepted).await {
+                LineIsolation::Isolated(rejected)
+                    if rejected.iter().map(|r| r.len() as u64).sum::<u64>()
+                        >= sent.len() as u64 =>
+                {
+                    // Review 2026-10-06: every line of this record was refused.
+                    // `isolate_refused_lines` answers `Isolated` here whenever an
+                    // earlier record of the file was accepted, so without this
+                    // arm a table-level refusal after one good record never
+                    // counted as "refused whole" and drained the whole backlog
+                    // into `.rejected-lines` instead of quarantining the file.
+                    refused_whole(dir, path, status, bytes, rows, progress, outcome)
+                }
+                LineIsolation::Isolated(rejected) => {
+                    let rejected_bytes: u64 = rejected.iter().map(|r| r.len() as u64).sum();
+                    if let Err(err) = set_aside_rejected_lines(dir, path, &sent, &rejected) {
+                        return RecordEnd::Retry("set_aside_rejected_lines", err.to_string());
+                    }
+                    let lines = rejected.len() as u64;
+                    metrics::counter!(REPLAY_LINES_REJECTED_COUNTER, "dir" => dir_label(dir))
+                        .increment(lines);
+                    outcome.lines_set_aside = outcome.lines_set_aside.saturating_add(lines);
+                    // At least one line of the record was accepted (the arm
+                    // above takes a record refused line for line).
+                    let accepted = (sent.len() as u64).saturating_sub(rejected_bytes);
+                    progress.any_accepted = true;
+                    progress.refused_whole_in_a_row = 0;
+                    note_replayed(outcome, accepted);
+                    error!(
+                        code = ErrorCode::TickSpill01FileQuarantined.code_str(),
+                        source = "depth_framed_lines_rejected",
+                        path = %path.display(),
+                        status,
+                        lines,
+                        bytes = rejected_bytes,
+                        "QuestDB refused single lines in a framed depth spill record. They are \
+                         kept in quarantine as <file>.rejected-lines and are NOT in the \
+                         database; every other row of the record was accepted and the replay \
+                         carries on."
+                    );
+                    RecordEnd::Done
+                }
+                LineIsolation::Transient => RecordEnd::Retry(
+                    "isolate",
+                    "QuestDB stopped answering while refused lines were isolated".to_string(),
+                ),
+                LineIsolation::WholeFile => {
+                    refused_whole(dir, path, status, bytes, rows, progress, outcome)
+                }
+            }
+        }
+        Ok(resp) => RecordEnd::Retry("post", format!("HTTP {}", resp.status().as_u16())),
+        Err(err) => RecordEnd::Retry("post", describe_send_error(&err).to_string()),
+    }
+}
+
+/// A record QuestDB refused whole (no line of it accepted). Finding
+/// 2026-10-06: one framed record is one rescue batch, often a single row, so
+/// it alone must not decide the file's fate. Set it aside and carry on,
+/// unless records keep being refused whole (a table-level refusal): at
+/// [`FRAMED_REFUSED_WHOLE_IN_A_ROW_QUARANTINE`] in a row the file is
+/// quarantined. O(1) plus the set-aside write.
+fn refused_whole(
+    dir: &Path,
+    path: &Path,
+    status: u16,
+    bytes: &[u8],
+    rows: u64,
+    progress: &mut FileProgress,
+    outcome: &mut SpillReplayOutcome,
+) -> RecordEnd {
+    progress.refused_whole_in_a_row = progress.refused_whole_in_a_row.saturating_add(1);
+    if progress.refused_whole_in_a_row >= FRAMED_REFUSED_WHOLE_IN_A_ROW_QUARANTINE {
+        quarantine_whole_file(dir, path, status, outcome)
+    } else {
+        set_aside_record(dir, path, SetAside::Refused, bytes, rows, outcome)
+    }
+}
+
+/// Rows a corrupt or torn span holds, for the loss counters. Walks the span
+/// and adds the row count of every header that passes its own CRC (its
+/// payload CRC failed, or its payload was torn): adjacent corrupt records
+/// merge into one span, and each one's rows are lost (review 2026-10-06:
+/// counting only the span's first header under-reported every later record
+/// in it). After a counted header the walk resumes past that header only,
+/// never past its claimed payload, because a torn record can hold a later
+/// append inside its claimed length. 1 when no header in the span decodes:
+/// no trustworthy count exists. O(span bytes), cold, no allocation.
+fn rows_in_span(bytes: &[u8]) -> u64 {
+    let magic = crate::depth_spill_frame::FRAME_MAGIC;
+    let mut rows = 0_u64;
+    let mut found = false;
+    let mut at = 0_usize;
+    // O(1) EXEMPT: begin — cold walk over a span already set aside.
+    while let Some(rel) = bytes
+        .get(at..)
+        .and_then(|rest| rest.windows(magic.len()).position(|w| w == magic))
+    {
+        let k = at + rel;
+        if let Ok(h) = crate::depth_spill_frame::decode_header(&bytes[k..]) {
+            found = true;
+            rows = rows.saturating_add(u64::from(h.rows.max(1)));
+            at = k + FRAME_HEADER_BYTES;
+        } else {
+            at = k + 1;
+        }
+    }
+    // O(1) EXEMPT: end
+    if found { rows } else { 1 }
+}
+
+/// True when the payload's first line is a `market_depth` row: the table
+/// name followed by a tag separator or the field separator.
+fn is_market_depth_payload(payload: &[u8]) -> bool {
+    payload
+        .strip_prefix(crate::depth_persistence::MARKET_DEPTH_TABLE.as_bytes())
+        .is_some_and(|rest| matches!(rest.first(), Some(b',' | b' ')))
+}
+
+fn set_aside_record(
+    dir: &Path,
+    path: &Path,
+    kind: SetAside,
+    bytes: &[u8],
+    rows: u64,
+    outcome: &mut SpillReplayOutcome,
+) -> RecordEnd {
+    match set_aside(dir, path, kind, bytes, rows, outcome) {
+        Ok(()) => RecordEnd::Done,
+        Err(err) => RecordEnd::Retry("set_aside", err.to_string()),
+    }
+}
+
+/// Appends `bytes` to `quarantine/<file><suffix>` and syncs it, then counts
+/// and logs the set-aside. Kept byte for byte, never deleted by the replay;
+/// the quarantine trim deletes only with a verified cold copy.
+fn set_aside(
+    dir: &Path,
+    path: &Path,
+    kind: SetAside,
+    bytes: &[u8],
+    rows: u64,
+    outcome: &mut SpillReplayOutcome,
+) -> std::io::Result<()> {
+    let quarantine = dir.join(QUARANTINE_DIR);
+    std::fs::create_dir_all(&quarantine)?;
+    let name = path
+        .file_name()
+        .and_then(|n| n.to_str())
+        .unwrap_or("depth-spill");
+    let target = quarantine.join(format!("{name}{}", kind.suffix()));
+    let mut file = std::fs::OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(&target)?;
+    file.write_all(bytes)?;
+    file.sync_data()?;
+    metrics::counter!(FRAME_SET_ASIDE_BYTES_COUNTER, "reason" => kind.reason())
+        .increment(bytes.len() as u64);
+    metrics::counter!(REPLAY_LINES_REJECTED_COUNTER, "dir" => dir_label(dir)).increment(rows);
+    outcome.lines_set_aside = outcome.lines_set_aside.saturating_add(rows);
+    error!(
+        code = ErrorCode::TickSpill01FileQuarantined.code_str(),
+        source = kind.source(),
+        path = %path.display(),
+        kept_in = %target.display(),
+        bytes = bytes.len(),
+        rows,
+        "framed depth spill bytes were SET ASIDE instead of posted ({}). They are kept in \
+         quarantine, synced, and are NOT in the database; every whole record before and \
+         after them still replays. See the TICK-SPILL-01 runbook, depth framed spill section.",
+        kind.reason()
+    );
+    Ok(())
+}
+
+/// Moves the whole file to quarantine under the append lock (no appender has
+/// it open while it moves).
+fn quarantine_whole_file(
+    dir: &Path,
+    path: &Path,
+    status: u16,
+    outcome: &mut SpillReplayOutcome,
+) -> RecordEnd {
+    let moved = {
+        let mut guard = append_lock();
+        let moved = quarantine_spill_file(dir, path);
+        if moved.is_ok() {
+            guard.forget_removed(path);
+        }
+        moved
+    };
+    match moved {
+        Ok(moved) => {
+            metrics::counter!(REPLAY_QUARANTINED_COUNTER).increment(1);
+            outcome.files_quarantined = outcome.files_quarantined.saturating_add(1);
+            error!(
+                code = ErrorCode::TickSpill01FileQuarantined.code_str(),
+                source = "depth_framed_file_quarantined",
+                path = %moved.display(),
+                status,
+                "a framed depth spill file was PERMANENTLY refused by QuestDB: several records in a \
+                 row were refused whole (no single line explains them), so the whole file was \
+                 moved to quarantine. The records refused before it are also kept as \
+                 <file>.refused-records. Records already \
+                 accepted ARE in the database; the rest are on disk and are NOT. Move it back \
+                 into the depth spill folder with a name ending .ilpf to retry it."
+            );
+            RecordEnd::FileQuarantined
+        }
+        Err(err) => RecordEnd::Retry("quarantine", err.to_string()),
+    }
+}
+
+fn note_replayed(outcome: &mut SpillReplayOutcome, bytes: u64) {
+    outcome.bytes_replayed = outcome.bytes_replayed.saturating_add(bytes);
+    metrics::counter!("tv_tick_spill_replayed_bytes_total").increment(bytes);
+}
+
+/// Removes a zero-length framed file under the lock if it is still empty.
+fn remove_if_still_empty(path: &Path) {
+    let mut guard = append_lock();
+    if std::fs::metadata(path).is_ok_and(|m| m.len() == 0) && std::fs::remove_file(path).is_ok() {
+        guard.forget_removed(path);
+        forget_resume_offset(path);
+    }
+}
+
+/// End of the snapshot: remove the file if it did not grow, otherwise
+/// remember the offset (a record boundary) for the next round.
+fn finish_framed_file(path: &Path, file_len: u64, outcome: &mut SpillReplayOutcome) -> FileEnd {
+    let mut guard = append_lock();
+    match std::fs::metadata(path).map(|m| m.len()) {
+        Ok(len_now) if len_now == file_len => match std::fs::remove_file(path) {
+            Ok(()) => {
+                guard.forget_removed(path);
+                forget_resume_offset(path);
+                drop(guard);
+                outcome.files_replayed = outcome.files_replayed.saturating_add(1);
+                info!(
+                    path = %path.display(),
+                    bytes = file_len,
+                    "drained a framed depth spill file into the database and removed it"
+                );
+                FileEnd::Next
+            }
+            Err(err) => {
+                drop(guard);
+                record_resume_offset(path, file_len);
+                outcome.files_failed = outcome.files_failed.saturating_add(1);
+                metrics::counter!("tv_tick_spill_replay_failed_total").increment(1);
+                error!(
+                    code = ErrorCode::TickSpill01FileQuarantined.code_str(),
+                    source = "depth_framed_accepted_not_removed",
+                    path = %path.display(),
+                    %err,
+                    "a framed depth spill file was fully handled but could not be removed. \
+                     Its rows ARE in the database; the file is kept and this process will not \
+                     send it again (a restart re-sends it, and the rows upsert onto themselves)."
+                );
+                FileEnd::StopRound
+            }
+        },
+        Ok(len_now) if len_now > file_len => {
+            drop(guard);
+            record_resume_offset(path, file_len);
+            outcome.files_replayed = outcome.files_replayed.saturating_add(1);
+            info!(
+                path = %path.display(),
+                len_before = file_len,
+                len_now,
+                "a framed depth spill file grew while it drained; it is kept and the next \
+                 round starts at the drained offset"
+            );
+            FileEnd::Next
+        }
+        Ok(len_now) => {
+            drop(guard);
+            stop_round(
+                outcome,
+                path,
+                None,
+                "shrank",
+                &format!("the file is {len_now} bytes, below its {file_len}-byte snapshot"),
+            )
+        }
+        Err(err) => {
+            drop(guard);
+            stop_round(outcome, path, Some(file_len), "stat", &err)
+        }
+    }
+}
+
+/// A transient failure: remember where to resume (always a span start),
+/// count it, and stop the round. The file is kept as it is.
+fn stop_round(
+    outcome: &mut SpillReplayOutcome,
+    path: &Path,
+    resume_at: Option<u64>,
+    stage: &'static str,
+    err: &dyn std::fmt::Display,
+) -> FileEnd {
+    if let Some(at) = resume_at {
+        record_resume_offset(path, at);
+    }
+    outcome.files_failed = outcome.files_failed.saturating_add(1);
+    metrics::counter!("tv_tick_spill_replay_failed_total").increment(1);
+    warn!(
+        code = ErrorCode::TickSpill01FileQuarantined.code_str(),
+        source = "depth_framed_replay_deferred",
+        stage,
+        path = %path.display(),
+        resume_at = resume_at.unwrap_or(0),
+        %err,
+        "framed depth spill replay stopped this round; the file is kept intact and the next \
+         round resumes at a record boundary. Nothing is lost: the bytes are on disk."
+    );
+    FileEnd::StopRound
+}
