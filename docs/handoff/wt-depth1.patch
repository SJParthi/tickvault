+    async fn mid_file_corruption_resyncs_and_keeps_the_exact_bytes() {
+        let dir = depth_dir("corrupt");
+        let path = dir.join("depth-dhan-1.ilpf");
+        let a = record(FRAME_KIND_ILP_V1_LINES, &lines(0..3));
+        let mut b = record(FRAME_KIND_ILP_V1_LINES, &lines(3..6));
+        let c = record(FRAME_KIND_ILP_V1_LINES, &lines(6..9));
+        // Bit rot in b's payload: its CRC fails.
+        let at = FRAME_HEADER_BYTES + 10;
+        b[at] ^= 0x20;
+        let mut file = a.clone();
+        file.extend_from_slice(&b);
+        file.extend_from_slice(b"\x00\x01garbage between records");
+        file.extend_from_slice(&c);
