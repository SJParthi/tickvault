+
+    /// Appends and syncs until an append finds both entries already synced.
+    /// Other tests in this process remove files (bumping the removal epoch)
+    /// and fill the bounded list, either of which only voids a mark, so a
+    /// mark is retried rather than assumed on the first try.
+    fn settle(path: &Path) {
+        for _ in 0..1_000 {
+            let (_f, t) =
+                append_v1_records(path, b"market_depth a=0i 1\n", (1, 1)).expect("settle");
+            if t.is_done() {
+                return;
+            }
+            sync_dir_entries(path, t).expect("settle sync");
+        }
+        panic!("the directory entries never settled as synced");
+    }
+
+    /// Finding 2026-10-06: an entry nobody synced stays pending however many
+    /// appends follow (an unsynced create by the drain's inline fallback is
+    /// the production shape), a sync marks it, a replay removal in between
+    /// voids the in-flight mark, and a failed sync marks nothing.
+    #[test]
+    fn sync_dir_entries_marks_only_what_it_synced_and_a_removal_voids_the_mark() {
+        let dir = scratch("dir-entry");
+        let path = dir.join("depth-dhan-1.ilpf");
+        let count = || test_hooks::DIR_SYNCS.with(std::cell::Cell::get);
+        let (_f, first) = append_v1_records(&path, b"market_depth a=1i 1\n", (1, 1)).expect("a");
+        let (_f, second) = append_v1_records(&path, b"market_depth a=2i 2\n", (2, 2)).expect("b");
+        assert!(
+            first.file_entry && first.dir_entry,
+            "a new file in a new directory"
+        );
+        assert!(
+            second.file_entry && second.dir_entry,
+            "an unsynced create stays pending for the next append"
+        );
+        let before = count();
+        sync_dir_entries(&path, second).expect("sync");
+        assert_eq!(
+            count(),
+            before + 2,
+            "the file's entry and the directory's entry"
+        );
+        settle(&path);
+        let before = count();
+        let done = DirSyncTicket {
+            file_entry: false,
+            dir_entry: false,
+            removals: 0,
+        };
+        sync_dir_entries(&path, done).expect("nothing to do");
+        assert_eq!(count(), before, "a done ticket syncs nothing");
+
+        // A removal between the ticket and its sync: the mark is voided.
+        let other = dir.join("depth-dhan-2.ilpf");
+        let (_f, ticket) = append_v1_records(&other, b"market_depth a=4i 4\n", (4, 4)).expect("d");
+        assert!(ticket.file_entry);
+        append_lock().forget_removed(&other);
+        sync_dir_entries(&other, ticket).expect("sync");
+        let (_f, again) = append_v1_records(&other, b"market_depth a=5i 5\n", (5, 5)).expect("e");
+        assert!(
+            again.file_entry,
+            "a removal in between leaves the entry pending"
+        );
+        settle(&other);
+        append_lock().forget_removed(&other);
+        let (_f, gone) = append_v1_records(&other, b"market_depth a=7i 7\n", (7, 7)).expect("g");
+        assert!(
+            gone.file_entry,
+            "a removed file's entry must be synced again"
+        );
+
+        // A failed sync marks nothing.
+        let missing = dir.join("missing").join("depth-dhan-3.ilpf");
+        let failing = DirSyncTicket {
+            file_entry: true,
+            dir_entry: false,
+            removals: append_lock().removals,
+        };
+        assert!(sync_dir_entries(&missing, failing).is_err());
+        assert!(!append_lock().is_synced(&missing));
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+
+    #[test]
+    fn forget_removed_unmarks_and_the_synced_list_stays_bounded() {
