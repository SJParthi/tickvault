+                "cut {cut}: the whole record replays"
+            );
+            assert_eq!(
+                quarantined(&dir, "depth-dhan-1.ilpf.torn-tail"),
+                second[..cut].to_vec(),
+                "cut {cut}: the torn bytes are kept exactly"
+            );
+            // A torn tail that still holds its whole header counts the rows the
+            // header declares (3); a shorter one has no trustworthy count (1).
+            let want_rows = if cut >= FRAME_HEADER_BYTES {
+                3
+            } else {
+                u64::from(cut > 0)
+            };
+            assert_eq!(out.lines_set_aside, want_rows, "cut {cut}");
+            assert_eq!(out.files_replayed, 1, "cut {cut}");
+            assert!(!path.exists(), "cut {cut}: handled in full, removed");
+            cleanup(&dir, &path);
