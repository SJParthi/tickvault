+        let err = append_v1_records(&path, &line, (1, 1)).expect_err("refused");
+        assert_eq!(err.kind(), io::ErrorKind::InvalidData);
+        assert!(!path.exists(), "nothing was opened or written");
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+
+    /// Bite-check: with `append_lock` removed from `append_v1_records`, the
+    /// header and payload writes of different threads interleave and this
+    /// fails (verified by hand on 2026-10-06).
+    #[test]
+    fn append_lock_keeps_concurrent_appenders_from_interleaving_records() {
+        let dir = scratch("concurrent");
+        let path = dir.join("depth-dhan-1.ilpf");
+        let threads: Vec<_> = (0..8)
+            .map(|t| {
+                let path = path.clone();
+                std::thread::spawn(move || {
+                    for b in 0..200 {
+                        let mut payload = Vec::new();
+                        for l in 0..((b % 7) + 1) {
+                            payload.extend_from_slice(
+                                format!("market_depth t={t}i,b={b}i,l={l}i 1\n").as_bytes(),
+                            );
+                        }
+                        append_v1_records(&path, &payload, (t, b)).expect("append");
+                    }
+                })
+            })
+            .collect();
+        for t in threads {
+            t.join().expect("thread");
+        }
+        let bytes = std::fs::read(&path).expect("read");
+        let found = spans(&bytes, 1 << 16);
+        assert_eq!(found.len(), 1600, "every batch is one whole record");
+        assert!(
+            found
+                .iter()
+                .all(|(_, _, k)| matches!(k, SpanKind::Record(_)))
+        );
+        let mut got: Vec<String> = String::from_utf8(framed_payloads(&path))
+            .expect("utf8")
+            .lines()
+            .map(str::to_string)
+            .collect();
+        let mut want = Vec::new();
+        for t in 0..8 {
+            for b in 0..200 {
+                for l in 0..((b % 7) + 1) {
+                    want.push(format!("market_depth t={t}i,b={b}i,l={l}i 1"));
+                }
+            }
+        }
+        got.sort();
+        want.sort();
+        assert_eq!(got, want, "the row multiset is exactly the input");
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+
+    #[test]
+    fn next_span_still_advances_on_a_record_larger_than_a_tiny_window() {
+        let rec = record(FRAME_KIND_ILP_V1_LINES, &[b'z'; 200], (1, 1));
+        let found = spans(&rec, 100);
+        let covered: u64 = found.iter().map(|(s, e, _)| e - s).sum();
+        assert_eq!(covered, rec.len() as u64, "every byte is accounted for");
+    }
+
+    proptest! {
+        #![proptest_config(ProptestConfig::with_cases(256))]
+        /// Random records, a random cut point (a crash mid-append), an
+        /// optional garbage splice (bit rot or a failed cut-back), and a
+        /// random window. The spans always cover the file exactly, in order,
+        /// and every record left whole by the damage is read as a record.
+        #[test]
+        fn crash_permutations_never_lose_a_byte(
+            payloads in proptest::collection::vec(proptest::collection::vec(any::<u8>(), 1..300), 1..12),
+            cut_frac in 0.0_f64..=1.0,
+            splice in proptest::option::of((0.0_f64..=1.0, proptest::collection::vec(any::<u8>(), 1..90))),
+            window in 400_usize..1500,
+            more_after in proptest::collection::vec(proptest::collection::vec(any::<u8>(), 1..200), 0..3),
+        ) {
+            let mut file = Vec::new();
+            let mut originals: Vec<(usize, usize)> = Vec::new();
+            for p in &payloads {
+                let start = file.len();
+                file.extend_from_slice(&record(FRAME_KIND_ILP_V1_LINES, p, (1, 2)));
+                originals.push((start, file.len()));
+            }
+            // A crash cuts the file somewhere.
+            let cut = ((file.len() as f64) * cut_frac) as usize;
+            file.truncate(cut.min(file.len()));
+            originals.retain(|(_, e)| *e <= file.len());
+            // Optionally splice garbage in at a random point.
+            let mut garbage: Option<(usize, usize)> = None;
+            if let Some((at_frac, junk)) = &splice {
+                let at = ((file.len() as f64) * at_frac) as usize;
+                let at = at.min(file.len());
+                file.splice(at..at, junk.iter().copied());
+                garbage = Some((at, junk.len()));
+                originals = originals
+                    .into_iter()
+                    .filter_map(|(s, e)| {
+                        if e <= at { Some((s, e)) }
+                        else if s >= at { Some((s + junk.len(), e + junk.len())) }
+                        else { None } // the splice landed inside this record
+                    })
+                    .collect();
+            }
+            // A later process appends more whole records.
+            for p in &more_after {
+                let start = file.len();
+                file.extend_from_slice(&record(FRAME_KIND_ILP_V1_LINES, p, (3, 4)));
+                originals.push((start, file.len()));
+            }
+            let found = spans(&file, window);
+            // Exact, ordered cover.
+            let mut pos = 0_u64;
+            for (s, e, _) in &found {
+                prop_assert_eq!(*s, pos);
+                prop_assert!(*e > *s);
+                pos = *e;
+            }
+            prop_assert_eq!(pos, file.len() as u64);
+            // Every surviving whole record is read as a record.
+            let records: Vec<(u64, u64)> = found
+                .iter()
+                .filter(|(_, _, k)| matches!(k, SpanKind::Record(_)))
+                .map(|(s, e, _)| (*s, *e))
+                .collect();
+            for (s, e) in &originals {
+                prop_assert!(
+                    records.contains(&(*s as u64, *e as u64)),
+                    "record {}..{} was not replayed (garbage {:?}, spans {:?})", s, e, garbage, found
+                );
+            }
+        }
+    }
