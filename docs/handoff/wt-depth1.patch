+    /// Reads each WHOLE body (by Content-Length) and records it. 400 for a
+    /// body containing `poison`, 503 for `busy` when `busy_is_transient`,
+    /// 204 otherwise. `on_first` runs once, when the first body arrives.
+    async fn spawn_recording_server(
+        busy_is_transient: bool,
+        on_first: Option<Box<dyn FnOnce() + Send>>,
+    ) -> Server {
+        use tokio::io::{AsyncReadExt, AsyncWriteExt};
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0")
+            .await
