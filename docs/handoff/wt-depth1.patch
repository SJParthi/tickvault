+#[cfg(not(test))]
+fn write_with_test_hooks(
+    file: &mut File,
+    payload: &[u8],
+    ranges: &[std::ops::Range<usize>],
+    headers: &[[u8; FRAME_HEADER_BYTES]],
+    whole: &mut u64,
+) -> io::Result<()> {
+    write_v1_records(file, payload, ranges, headers, whole)
+}
+
+#[cfg(not(test))]
+fn cut_back(file: &File, start: u64) -> io::Result<()> {
+    file.set_len(start)
+}
+
+#[cfg(test)]
+fn write_with_test_hooks(
+    file: &mut File,
+    payload: &[u8],
+    ranges: &[std::ops::Range<usize>],
+    headers: &[[u8; FRAME_HEADER_BYTES]],
+    whole: &mut u64,
+) -> io::Result<()> {
+    match test_hooks::FAIL_WRITE_AFTER.with(std::cell::Cell::take) {
+        Some(budget) => {
+            let mut out = test_hooks::FailingWriter {
+                inner: file,
+                left: budget,
+            };
+            write_v1_records(&mut out, payload, ranges, headers, whole)
+        }
+        None => write_v1_records(file, payload, ranges, headers, whole),
+    }
+}
+
+#[cfg(test)]
+fn cut_back(file: &File, start: u64) -> io::Result<()> {
+    if test_hooks::FAIL_CUT_BACK.with(std::cell::Cell::take) {
+        return Err(io::Error::other("injected cut-back failure"));
+    }
+    file.set_len(start)
+}
