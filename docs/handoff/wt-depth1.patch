+    );
+    let writer = body_of(&frame, "fn write_v1_records<");
+    let payload_write = writer
+        .find("out.write_all(&payload[range.clone()])?;")
+        .expect("the record payload is written");
+    let counted = writer.find("*whole +=").expect("whole records are counted");
+    assert!(
+        payload_write < counted,
+        "a record counts as whole only after its payload write returned"
+    );
+    for banned in ["sync_data(", "sync_all(", "sync(&"] {
+        assert!(
+            !append.contains(banned),
+            "append_v1_records must never sync under the append lock (found `{banned}`)"
+        );
+    }
+    let headers = append
+        .find("build_v1_headers(")
+        .expect("the headers are built in the append");
+    assert!(
+        headers < lock,
+        "the headers are built BEFORE the lock is taken"
+    );
+    for banned in ["encode_header(", "crc32_ieee(", "newline_count("] {
+        assert!(
+            !append[lock..].contains(banned),
+            "no CRC or row count may run under the append lock (found `{banned}`)"
+        );
+        assert!(
+            !body_of(&frame, "fn write_v1_records<").contains(banned),
+            "the writer under the lock writes prebuilt headers only (found `{banned}`)"
+        );
+    }
+    let dir_sync = body_of(&frame, "pub(crate) fn sync_dir_entries(");
+    let last_sync = dir_sync
+        .rfind("sync_parent_dir(")
+        .expect("the entries are synced");
+    let mark_lock = dir_sync
+        .find("append_lock()")
+        .expect("the marks are recorded under the lock");
+    assert!(
+        last_sync < mark_lock,
+        "every directory sync runs before the lock is taken for the marks"
+    );
+
+    let depth = production("depth_persistence.rs");
+    let spill = body_of(&depth, "fn spill_failed_depth_ilp(");
+    let sync = spill.find("sync(&file)?;").expect("the payload is synced");
+    let dir = spill
+        .find("sync_dir_entries(")
+        .expect("the directory entries still pending are synced");
+    let ok = spill.rfind("Ok(path)").expect("returns the path");
+    assert!(
+        sync < dir && dir < ok,
+        "file sync, then directory sync, then Ok"
+    );
+    assert!(
+        depth.contains("pub const DEPTH_SPILL_WRITES_FRAMED: bool = true;"),
+        "production writes the framed depth spill"
+    );
+}
