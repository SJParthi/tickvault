+    async fn a_torn_tail_is_set_aside_at_every_cut_offset() {
+        let first = record(FRAME_KIND_ILP_V1_LINES, &lines(0..3));
+        let second = record(FRAME_KIND_ILP_V1_LINES, &lines(3..6));
+        for cut in [
+            0,
+            1,
+            FRAME_HEADER_BYTES - 1,
+            FRAME_HEADER_BYTES,
+            FRAME_HEADER_BYTES + 20,
+            second.len() - 1,
+        ] {
+            let dir = depth_dir(&format!("torn-{cut}"));
+            let path = dir.join("depth-dhan-1.ilpf");
+            let mut file = first.clone();
