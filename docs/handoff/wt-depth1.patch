+    fn record(kind: u8, payload: &[u8], seq: (u64, u64)) -> Vec<u8> {
+        let mut out = encode_header(kind, payload, newline_count(payload), seq).to_vec();
+        out.extend_from_slice(payload);
+        out
+    }
+
+    /// All spans of `bytes`, read through a window of `window` bytes.
+    fn spans(bytes: &[u8], window: usize) -> Vec<(u64, u64, SpanKind)> {
+        let mut win = vec![0_u8; window];
+        let len = bytes.len() as u64;
+        let mut cursor = FramedCursor::new(std::io::Cursor::new(bytes.to_vec()), 0, len, &mut win);
+        let mut out = Vec::new();
+        while let Some(span) = cursor.next_span().expect("in-memory read") {
+            out.push((
+                span.offset,
+                span.offset + span.range.len() as u64,
+                span.kind,
+            ));
+            cursor.consume(&span);
+        }
+        out
+    }
