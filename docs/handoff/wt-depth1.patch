+        let server = spawn_recording_server(false, None).await;
+        let out = replay_framed_spill_dir(&dir, &server.url, &client()).await;
+        let mut want = lines(0..3);
+        want.extend_from_slice(&lines(6..9));
+        assert_eq!(
+            server.all_posted(),
+            want,
+            "a and c replay; b is never posted"
+        );
+        let mut kept = b.clone();
+        kept.extend_from_slice(b"\x00\x01garbage between records");
+        assert_eq!(quarantined(&dir, "depth-dhan-1.ilpf.corrupt-bytes"), kept);
+        assert_eq!(
+            out.lines_set_aside, 3,
+            "the corrupt record's own CRC-checked header says 3 rows"
+        );
+        cleanup(&dir, &path);
+    }
