+//! Length-framed records for the depth spill tier (plan item 49d-1,
+//! 2026-10-06).
+//!
+//! # Why the depth spill needs a frame
+//!
+//! The depth spill used to hold raw ILP text, one row per line, and the
+//! replay (`tick_spill_replay`) cuts, bisects and window-filters that text on
+//! `'\n'` and reads the timestamp after the last space. That only works while
+//! every byte of the spill is line protocol V1. Array rows (`DOUBLE[]` price,
+//! quantity and orders per packet, the 2026-10-06 scratch-table test) need
+//! ILP V2, and V2 writes every `f64` as eight raw little-endian bytes after
+//! `=` plus a type byte. Those bytes contain `'\n'` and `' '` freely, so a V2
+//! batch in the text spill would be cut apart on replay.
+//!
+//! A frame carries its own length and two CRC-32s, so the reader never looks
+//! inside the payload to find where a record ends. This step writes only
+//! kind 1 records (V1 text lines, exactly the bytes the text spill held); the
+//! format reserves kind 2 for V2 batches and the reader sets kind 2 aside
+//! rather than posting it until step 2 teaches it how.
+//!
+//! # Record layout (little-endian header, no file header)
+//!
+//! | Bytes | Field |
+//! |---|---|
+//! | 0..4 | magic `TVDF` |
+//! | 4 | version, 1 |
+//! | 5 | kind: 1 = ILP V1 text lines, 2 = ILP V2 batch (reserved) |
+//! | 6 | flags, 0 |
+//! | 7 | reserved, 0 |
+//! | 8..12 | payload length, `1..=FRAMED_MAX_PAYLOAD` |
+//! | 12..16 | rows (kind 1: the payload's newline count) |
+//! | 16..24 | lowest `capture_seq` of the batch (0 = unknown) |
+//! | 24..32 | highest `capture_seq` of the batch |
+//! | 32..40 | lowest row timestamp, nanos (0 = not recorded; always 0 here) |
+//! | 40..48 | highest row timestamp, nanos (same; both ignored on read, so a later writer may fill them) |
+//! | 48..52 | CRC-32 (IEEE) of the payload |
+//! | 52..60 | reserved, 0 |
+//! | 60..64 | CRC-32 (IEEE) of bytes 0..60 |
+//! | 64.. | payload, verbatim |
+//!
+//! # The append lock
+//!
+//! Every depth appender is in this process: the writer thread, the rescue
+//! thread, the drain's inline fallback (through `off_worker`), and the
+//! after-close pass. They all append to the same per-feed, per-hour file.
+//! [`append_lock`] serialises them so two records never interleave, and the
+//! replay takes the same lock to snapshot a file's length and to remove or
+//! quarantine it. A length read under the lock covers only finished appends,
+//! so every judgement inside that length is final: the replay never needs
+//! the text reader's "the last file may still be written" guess, and never
+//! truncates or removes a file an append is landing in.
+//!
+//! The lock is held for open, `fstat`, write and cut-back only, never across
+//! an fsync, a POST or a quarantine write, and never across the payload CRC
+//! or the newline count: [`append_v1_records`] builds every header before it
+//! takes the lock.
+//!
+//! The lock also guards the list of directory entries this process has
+//! synced ([`AppendState`]). A synced append syncs the spill file's entry
+//! and the spill directory's own entry the first time it finds either
+//! unsynced, whoever created the file, so a file first created by the
+//! drain's unsynced inline fallback is still made durable by the next synced
+//! append ([`sync_dir_entries`]).
+//!
+//! # Complexity
+//!
+//! Cold path: runs only after a depth flush failed. O(payload) per spilled
+//! batch (one CRC pass and one newline count before the lock, one write
+//! under it), at most four records for the 32 MiB producer cap. Header
+//! encode and decode are O(1). The synced-entry list is scanned linearly,
+//! at most [`DIR_ENTRY_SYNCED_LIMIT`] entries.
+//! [`next_record_start`] is O(scanned bytes) plus one payload CRC per
+//! candidate whose header CRC passes.
+
+use std::fs::File;
+use std::io::{self, Write};
+use std::path::{Path, PathBuf};
+use std::sync::{Mutex, MutexGuard, PoisonError};
+
+use tickvault_common::error_code::ErrorCode;
+use tracing::error;
+
+use crate::wal_applied_watermark::crc32_ieee;
+
+/// Extension of a length-framed depth spill file. The text lister
+/// (`tick_spill_replay::list_spill_files`) matches `ilp` exactly, so it never
+/// sees these files and never cuts one on a newline.
+pub const DEPTH_FRAMED_SPILL_EXTENSION: &str = "ilpf";
+
+/// Bytes in one record header.
+pub const FRAME_HEADER_BYTES: usize = 64;
+
+/// The magic that opens every record.
+pub const FRAME_MAGIC: [u8; 4] = *b"TVDF";
+
+/// The only record version this build writes and reads.
+pub const FRAME_VERSION: u8 = 1;
+
+/// Kind 1: the payload is ILP V1 text lines, posted verbatim.
+pub const FRAME_KIND_ILP_V1_LINES: u8 = 1;
+
+/// Kind 2: the payload is one ILP V2 batch. Reserved for plan item 49d step
+/// 2; never written by this build, and set aside (never posted) by its
+/// reader.
+pub const FRAME_KIND_ILP_V2_BATCH: u8 = 2;
+
+/// Largest payload one record carries: one replay POST body, so a record is
+/// always exactly one request.
+pub const FRAMED_MAX_PAYLOAD: usize = crate::tick_spill_replay::REPLAY_MAX_CHUNK_BYTES;
+
+const _: () = assert!(
+    FRAME_HEADER_BYTES + FRAMED_MAX_PAYLOAD <= crate::tick_spill_replay::REPLAY_STREAM_BUFFER_BYTES,
+    "one whole record must fit in the replay's read window, or a valid record could never \
+     be judged and the reader would have to guess"
+);
+
+const _: () = assert!(
+    FRAMED_MAX_PAYLOAD <= u32::MAX as usize,
+    "the payload length is a u32 on disk"
+);
+
+/// A decoded, CRC-checked record header. The timestamp fields are not exposed
+/// in this step (always written as 0, ignored on read).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct FrameHeader {
+    /// [`FRAME_KIND_ILP_V1_LINES`] or [`FRAME_KIND_ILP_V2_BATCH`].
+    pub kind: u8,
+    /// Payload bytes after the header.
+    pub payload_len: u32,
+    /// Rows in the payload.
+    pub rows: u32,
+    /// Lowest `capture_seq` of the batch the record came from (0 = unknown).
+    pub min_seq: u64,
+    /// Highest `capture_seq` of the batch the record came from.
+    pub max_seq: u64,
+    /// CRC-32 of the payload.
+    pub payload_crc: u32,
+}
+
+/// Why bytes are not a valid record header.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum FrameDefect {
+    /// Fewer than [`FRAME_HEADER_BYTES`] bytes.
+    Short,
+    /// The first four bytes are not [`FRAME_MAGIC`].
+    BadMagic,
+    /// The header CRC does not match bytes 0..60.
+    HeaderCrc,
+    /// A version this build does not read.
+    BadVersion,
+    /// A kind this build does not know.
+    BadKind,
+    /// A flag or reserved byte is not zero.
+    NonZeroReserved,
+    /// Payload length 0 or above [`FRAMED_MAX_PAYLOAD`].
+    BadLength,
+}
+
+fn u32_at(bytes: &[u8], at: usize) -> u32 {
+    let mut word = [0_u8; 4];
+    word.copy_from_slice(&bytes[at..at + 4]);
+    u32::from_le_bytes(word)
+}
+
+fn u64_at(bytes: &[u8], at: usize) -> u64 {
+    let mut word = [0_u8; 8];
+    word.copy_from_slice(&bytes[at..at + 8]);
+    u64::from_le_bytes(word)
+}
+
+/// Encodes a record header for `payload`. O(payload) for the payload CRC,
+/// no allocation.
+#[must_use]
+pub fn encode_header(
+    kind: u8,
+    payload: &[u8],
+    rows: u32,
+    seq: (u64, u64),
+) -> [u8; FRAME_HEADER_BYTES] {
+    let mut h = [0_u8; FRAME_HEADER_BYTES];
+    h[0..4].copy_from_slice(&FRAME_MAGIC);
+    h[4] = FRAME_VERSION;
+    h[5] = kind;
+    // h[6] flags, h[7] reserved: 0.
+    let len = u32::try_from(payload.len()).unwrap_or(u32::MAX);
+    h[8..12].copy_from_slice(&len.to_le_bytes());
+    h[12..16].copy_from_slice(&rows.to_le_bytes());
+    h[16..24].copy_from_slice(&seq.0.to_le_bytes());
+    h[24..32].copy_from_slice(&seq.1.to_le_bytes());
+    // 32..48: timestamp range, not recorded in this step (0).
+    h[48..52].copy_from_slice(&crc32_ieee(payload).to_le_bytes());
+    // 52..60 reserved: 0.
+    let header_crc = crc32_ieee(&h[0..60]);
+    h[60..64].copy_from_slice(&header_crc.to_le_bytes());
+    h
+}
+
+/// Decodes and checks the header at the start of `bytes`. Checks run magic,
+/// header CRC, version, kind, reserved bytes, length, so a garbage length is
+/// never trusted. O(1), no allocation.
+///
+/// # Errors
+///
+/// The first defect found.
+pub fn decode_header(bytes: &[u8]) -> Result<FrameHeader, FrameDefect> {
+    if bytes.len() < FRAME_HEADER_BYTES {
+        return Err(FrameDefect::Short);
+    }
+    if bytes[0..4] != FRAME_MAGIC {
+        return Err(FrameDefect::BadMagic);
+    }
+    if crc32_ieee(&bytes[0..60]) != u32_at(bytes, 60) {
+        return Err(FrameDefect::HeaderCrc);
+    }
+    if bytes[4] != FRAME_VERSION {
+        return Err(FrameDefect::BadVersion);
+    }
+    let kind = bytes[5];
+    if kind != FRAME_KIND_ILP_V1_LINES && kind != FRAME_KIND_ILP_V2_BATCH {
+        return Err(FrameDefect::BadKind);
+    }
+    // Bytes 32..48 (the timestamp range) are NOT checked: they are reserved
+    // for a later writer to fill, and a reader that refused them would set a
+    // later build's valid records aside (review 2026-10-06). This build
+    // writes them as 0 and ignores them.
+    // O(1) EXEMPT: a fixed 10-byte check, not a scan.
+    let reserved_clear = bytes[6] == 0 && bytes[7] == 0 && bytes[52..60].iter().all(|b| *b == 0);
+    if !reserved_clear {
+        return Err(FrameDefect::NonZeroReserved);
+    }
+    let payload_len = u32_at(bytes, 8);
+    if payload_len == 0 || payload_len as usize > FRAMED_MAX_PAYLOAD {
+        return Err(FrameDefect::BadLength);
+    }
+    Ok(FrameHeader {
+        kind,
+        payload_len,
+        rows: u32_at(bytes, 12),
+        min_seq: u64_at(bytes, 16),
+        max_seq: u64_at(bytes, 24),
+        payload_crc: u32_at(bytes, 48),
+    })
+}
+
+/// True when `payload` is the payload `header` describes: right length and
+/// matching CRC. O(payload).
+#[must_use]
+pub fn payload_ok(header: &FrameHeader, payload: &[u8]) -> bool {
+    payload.len() == header.payload_len as usize && crc32_ieee(payload) == header.payload_crc
+}
+
+/// Where the next record starts, scanning `buf` from `from`.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Resync {
+    /// A whole, CRC-checked record starts here.
+    Found(usize),
+    /// A record may start here but cannot be judged inside `buf` (fewer than
+    /// a header's bytes left, or a valid header whose payload runs past the
+    /// end of `buf`). The caller must read more before judging it.
+    Undecided(usize),
+    /// No position from `from` to the last whole magic in `buf` starts a
+    /// record. The last `FRAME_MAGIC.len() - 1` bytes may still begin one.
+    NotFound,
+}
+
+/// Scans for the next record start: the first magic whose header and
+/// payload both check, or the first candidate that cannot be judged inside
+/// `buf`. Candidates that fail are skipped. O(scanned bytes) plus one
+/// payload CRC per candidate whose header CRC passes; no allocation.
+#[must_use]
+pub fn next_record_start(buf: &[u8], from: usize) -> Resync {
+    let magic_len = FRAME_MAGIC.len();
+    if buf.len() < magic_len {
+        return Resync::NotFound;
+    }
+    let last = buf.len() - magic_len;
+    let mut k = from;
+    // O(1) EXEMPT: begin — cold resync over corrupt bytes, bounded by the window.
+    while k <= last {
+        let Some(rel) = buf[k..].windows(magic_len).position(|w| w == FRAME_MAGIC) else {
+            return Resync::NotFound;
+        };
+        k += rel;
+        if buf.len() - k < FRAME_HEADER_BYTES {
+            return Resync::Undecided(k);
+        }
+        if let Ok(h) = decode_header(&buf[k..]) {
+            let end = k + FRAME_HEADER_BYTES + h.payload_len as usize;
+            if end > buf.len() {
+                return Resync::Undecided(k);
+            }
+            if payload_ok(&h, &buf[k + FRAME_HEADER_BYTES..end]) {
+                return Resync::Found(k);
+            }
+        }
+        k += 1;
+    }
+    // O(1) EXEMPT: end
+    Resync::NotFound
+}
+
+/// What the bytes at one position of a read window are.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Step {
+    /// A whole, CRC-checked record of `len` bytes (header included).
+    Record { header: FrameHeader, len: usize },
+    /// Cannot be judged without more bytes; only returned while more bytes
+    /// of the snapshot remain to be read.
+    NeedMore,
+    /// `[at, end)` holds no record start: corrupt bytes to set aside.
+    Corrupt { end: usize },
+    /// `[at, buf.len())` is the end of the snapshot and holds no record
+    /// start: a torn tail to set aside.
+    TornTail,
+}
+
+/// Judges the bytes at `buf[at..]`. `more` says whether bytes of the file's
+/// locked snapshot remain beyond `buf`. Pure, no allocation.
+///
+/// Never skips a valid record: `Corrupt { end }` covers only bytes before the
+/// first candidate [`next_record_start`] could not rule out, and `TornTail`
+/// is returned only when no candidate remains at all.
+#[must_use]
+pub fn classify_at(buf: &[u8], at: usize, more: bool) -> Step {
+    let avail = buf.len().saturating_sub(at);
+    if avail < FRAME_HEADER_BYTES {
+        return if more {
+            Step::NeedMore
+        } else if avail == 0 {
+            // Nothing left; callers stop before this, kept total for safety.
+            Step::Corrupt { end: at }
+        } else {
+            Step::TornTail
+        };
+    }
+    if let Ok(h) = decode_header(&buf[at..]) {
+        let len = FRAME_HEADER_BYTES + h.payload_len as usize;
+        if avail < len {
+            if more {
+                return Step::NeedMore;
+            }
+            // The snapshot ends inside this record's claimed payload. Before
+            // calling it torn, look for a whole record inside the claimed
+            // span: a crash mid-append followed by a later process's append
+            // leaves exactly that shape, and the later record must replay.
+        } else if payload_ok(&h, &buf[at + FRAME_HEADER_BYTES..at + len]) {
+            return Step::Record { header: h, len };
+        }
+    }
+    match next_record_start(buf, at + 1) {
+        Resync::Found(end) | Resync::Undecided(end) => Step::Corrupt { end },
+        Resync::NotFound if more => Step::Corrupt {
+            end: buf.len() - (FRAME_MAGIC.len() - 1),
+        },
+        Resync::NotFound => Step::TornTail,
+    }
+}
+
+/// A run of bytes the reader handles as one unit.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum SpanKind {
+    /// A whole, CRC-checked record.
+    Record(FrameHeader),
+    /// Bytes with no record start in them, inside the snapshot.
+    Corrupt,
+    /// The end of the snapshot, holding no record start.
+    TornTail,
+}
+
+/// One span the cursor found: file offset, bytes in the window, kind.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Span {
+    /// File offset of the first byte.
+    pub offset: u64,
+    /// The span's bytes inside [`FramedCursor::window`].
+    pub range: std::ops::Range<usize>,
+    /// What the bytes are.
+    pub kind: SpanKind,
+}
+
+/// Streams a framed spill file from `start` to `end` (the locked snapshot)
+/// through a fixed window, one [`Span`] at a time. The window is the caller's,
+/// so one allocation serves a whole replay round. O(bytes read); a resync
+/// adds what [`next_record_start`] costs.
+pub struct FramedCursor<'w, R> {
+    src: R,
+    buf: &'w mut [u8],
+    filled: usize,
+    at: usize,
+    win_off: u64,
+    read_pos: u64,
+    end: u64,
+}
+
+impl<'w, R: io::Read> FramedCursor<'w, R> {
+    /// `src` must already be positioned at `start`. `window` must hold one
+    /// whole record (production passes `REPLAY_STREAM_BUFFER_BYTES`).
+    pub fn new(src: R, start: u64, end: u64, window: &'w mut [u8]) -> Self {
+        Self {
+            src,
+            buf: window,
+            filled: 0,
+            at: 0,
+            win_off: start,
+            read_pos: start,
+            end: end.max(start),
+        }
+    }
+
+    /// File offset of the first byte not yet consumed: always a span start.
+    #[must_use]
+    pub fn position(&self) -> u64 {
+        self.win_off + self.at as u64
+    }
+
+    /// The window the spans' ranges index into.
+    #[must_use]
+    pub fn window(&self) -> &[u8] {
+        &self.buf[..self.filled]
+    }
+
+    /// Marks `span` handled; the next call starts after it.
+    pub fn consume(&mut self, span: &Span) {
+        self.at = span.range.end.min(self.filled);
+    }
+
+    /// The next span, or `None` at the end of the snapshot.
+    ///
+    /// # Errors
+    ///
+    /// A read error, or the file being shorter than its locked snapshot
+    /// (`UnexpectedEof`). Nothing was consumed; [`Self::position`] is where
+    /// a retry must start.
+    pub fn next_span(&mut self) -> io::Result<Option<Span>> {
+        loop {
+            if self.position() >= self.end {
+                return Ok(None);
+            }
+            let more = self.read_pos < self.end;
+            let step = classify_at(&self.buf[..self.filled], self.at, more);
+            let offset = self.position();
+            match step {
+                Step::NeedMore => {
+                    if self.at == 0 && self.filled == self.buf.len() {
+                        // A full window and still undecidable: only a window
+                        // smaller than one record can do this (production's
+                        // is asserted large enough). Treat the first byte as
+                        // corrupt and resync, so the cursor always advances.
+                        let end = match next_record_start(&self.buf[..self.filled], 1) {
+                            Resync::Found(j) | Resync::Undecided(j) => j,
+                            Resync::NotFound => self.filled - (FRAME_MAGIC.len() - 1),
+                        };
+                        return Ok(Some(Span {
+                            offset,
+                            range: 0..end,
+                            kind: SpanKind::Corrupt,
+                        }));
+                    }
+                    self.refill()?;
+                }
+                Step::Record { header, len } => {
+                    return Ok(Some(Span {
+                        offset,
+                        range: self.at..self.at + len,
+                        kind: SpanKind::Record(header),
+                    }));
+                }
+                Step::Corrupt { end } => {
+                    return Ok(Some(Span {
+                        offset,
+                        range: self.at..end.max(self.at + 1).min(self.filled),
+                        kind: SpanKind::Corrupt,
+                    }));
+                }
+                Step::TornTail => {
+                    return Ok(Some(Span {
+                        offset,
+                        range: self.at..self.filled,
+                        kind: SpanKind::TornTail,
+                    }));
+                }
+            }
+        }
+    }
+
+    fn refill(&mut self) -> io::Result<()> {
+        if self.at > 0 {
+            self.buf.copy_within(self.at..self.filled, 0);
+            self.filled -= self.at;
+            self.win_off += self.at as u64;
+            self.at = 0;
+        }
+        while self.filled < self.buf.len() && self.read_pos < self.end {
+            let left = usize::try_from(self.end - self.read_pos).unwrap_or(usize::MAX);
+            let want = (self.buf.len() - self.filled).min(left);
+            match self
+                .src
+                .read(&mut self.buf[self.filled..self.filled + want])
+            {
+                Ok(0) => {
+                    return Err(io::Error::new(
+                        io::ErrorKind::UnexpectedEof,
+                        "the framed spill file is shorter than its locked snapshot",
+                    ));
+                }
+                Ok(n) => {
+                    self.filled += n;
+                    self.read_pos += n as u64;
+                }
+                Err(err) if err.kind() == io::ErrorKind::Interrupted => {}
+                Err(err) => return Err(err),
+            }
+        }
+        Ok(())
+    }
+}
+
+/// What the depth spill append lock guards besides the files themselves:
+/// which directory entries this process has already synced (finding
+/// 2026-10-06: a file created by an UNSYNCED append, the drain's inline
+/// fallback, or by a synced append whose file sync failed, must still have
+/// its directory entry synced by the next synced append).
+pub(crate) struct AppendState {
+    /// Paths whose entry in their parent directory has been synced in this
+    /// process: spill files and the spill directory itself. At most
+    /// [`DIR_ENTRY_SYNCED_LIMIT`]; past it the list is cleared, which only
+    /// makes the next synced appends sync again (never skips a sync).
+    synced: Vec<PathBuf>,
+    /// Bumped by every replay remove or quarantine of a spill file. A mark
+    /// is recorded only if no removal happened between the append that asked
+    /// for the sync and the sync itself, so a file removed and created again
+    /// under the same name is never taken as synced.
+    removals: u64,
+}
+
+/// Bound on [`AppendState::synced`]: one entry per feed per hour plus the
+/// directory, so a day of hours fits with room.
+pub(crate) const DIR_ENTRY_SYNCED_LIMIT: usize = 64;
+
+impl AppendState {
+    /// The replay removed or quarantined `path`: its entry is no longer
+    /// synced, and any sync already in flight must not mark it.
+    pub(crate) fn forget_removed(&mut self, path: &Path) {
+        self.removals = self.removals.wrapping_add(1);
+        // O(1) EXEMPT: a scan of at most DIR_ENTRY_SYNCED_LIMIT entries, cold.
+        self.synced.retain(|p| p != path);
+    }
+
+    fn is_synced(&self, path: &Path) -> bool {
+        // O(1) EXEMPT: a scan of at most DIR_ENTRY_SYNCED_LIMIT entries, cold.
+        self.synced.iter().any(|p| p == path)
+    }
+
+    fn mark_synced(&mut self, path: &Path) {
+        if self.is_synced(path) {
+            return;
+        }
+        if self.synced.len() >= DIR_ENTRY_SYNCED_LIMIT {
+            self.synced.clear();
+        }
+        self.synced.push(path.to_path_buf()); // APPROVED: cold, bounded by DIR_ENTRY_SYNCED_LIMIT
+    }
+}
+
+/// Serialises every depth spill append and the replay's snapshot, remove and
+/// quarantine (see the module header), and holds [`AppendState`].
+static DEPTH_SPILL_APPEND: Mutex<AppendState> = Mutex::new(AppendState {
+    synced: Vec::new(),
+    removals: 0,
+});
+
+/// Takes the depth spill append lock. A poisoned lock is recovered: the
+/// guarded state is the file, which each holder leaves at a record boundary
+/// or reports, plus a list whose only failure direction is "sync again".
+pub(crate) fn append_lock() -> MutexGuard<'static, AppendState> {
+    DEPTH_SPILL_APPEND
+        .lock()
+        .unwrap_or_else(PoisonError::into_inner)
+}
+
+/// Which directory entries a synced append still has to sync, read under the
+/// append lock by [`append_v1_records`]. An unsynced caller ignores it.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) struct DirSyncTicket {
+    /// The spill file's entry in the spill directory is not yet synced.
+    pub(crate) file_entry: bool,
+    /// The spill directory's entry in its parent is not yet synced.
+    pub(crate) dir_entry: bool,
+    removals: u64,
+}
+
+impl DirSyncTicket {
+    /// True when nothing is left to sync.
+    #[must_use]
+    pub(crate) fn is_done(&self) -> bool {
+        !self.file_entry && !self.dir_entry
+    }
+}
+
+/// Syncs every directory entry `ticket` names (the spill directory for the
+/// file's entry, its parent for the directory's own entry), WITHOUT the
+/// append lock, then marks them synced under the lock unless the replay
+/// removed a spill file meanwhile. A failed sync marks nothing, so the next
+/// synced append retries it. Cold: the synced spill paths only.
+///
+/// # Errors
+///
+/// The first open or sync error.
+pub(crate) fn sync_dir_entries(path: &Path, ticket: DirSyncTicket) -> io::Result<()> {
+    if ticket.is_done() {
+        return Ok(());
+    }
+    let dir = path.parent().unwrap_or_else(|| Path::new("."));
+    if ticket.file_entry {
+        sync_parent_dir(path)?;
+    }
+    if ticket.dir_entry {
+        sync_parent_dir(dir)?;
+    }
+    let mut state = append_lock();
+    if state.removals == ticket.removals {
+        if ticket.file_entry {
+            state.mark_synced(path);
+        }
+        if ticket.dir_entry {
+            state.mark_synced(dir);
+        }
+    }
+    Ok(())
+}
+
+/// Newlines in `bytes`, as a `u32` row count. O(bytes).
+fn newline_count(bytes: &[u8]) -> u32 {
+    let n = bytes.iter().filter(|b| **b == b'\n').count();
+    u32::try_from(n).unwrap_or(u32::MAX)
+}
+
+/// Builds one kind-1 header per line-aligned chunk of `payload`: the payload
+/// CRC and the newline count, O(payload). Called BEFORE the append lock is
+/// taken, so a holder of the lock never spends it on CRC work another
+/// appender (the drain's inline fallback among them) would wait for.
+fn build_v1_headers(
+    payload: &[u8],
+    ranges: &[std::ops::Range<usize>],
+    seq: (u64, u64),
+) -> Vec<[u8; FRAME_HEADER_BYTES]> {
+    ranges
+        .iter()
+        .map(|range| {
+            let chunk = &payload[range.clone()];
+            encode_header(FRAME_KIND_ILP_V1_LINES, chunk, newline_count(chunk), seq)
+        })
+        .collect() // APPROVED: cold rescue path, one header per record (at most four for the 32 MiB cap)
+}
+
+/// Writes one prebuilt header and its chunk per record. No CRC here: the
+/// headers were built before the lock.
+///
+/// `whole` is raised by each record's full length (header plus payload) as
+/// soon as that record is written in full, so on an error it holds the bytes
+/// of the records that DID land whole. The caller cuts back to that point and
+/// keeps them (review 2026-10-06: cutting back to the batch start threw away
+/// whole, checksummed records the old text tier would have kept).
+fn write_v1_records<W: Write>(
+    out: &mut W,
+    payload: &[u8],
+    ranges: &[std::ops::Range<usize>],
+    headers: &[[u8; FRAME_HEADER_BYTES]],
+    whole: &mut u64,
+) -> io::Result<()> {
+    // O(1) EXEMPT: begin — cold rescue path, at most four records per batch.
+    for (range, header) in ranges.iter().zip(headers) {
+        out.write_all(header)?;
+        out.write_all(&payload[range.clone()])?;
+        *whole += (FRAME_HEADER_BYTES + range.len()) as u64;
+    }
+    // O(1) EXEMPT: end
+    Ok(())
+}
+
+/// Appends `payload` (ILP V1 text) to `path` as kind-1 records of at most
+/// [`FRAMED_MAX_PAYLOAD`] bytes each, split on line boundaries. The headers
+/// (CRC, row count) are built first; the append lock is then held only for
+/// open, `fstat`, write and cut-back. Returns the open file (for the caller's
+/// sync) and the [`DirSyncTicket`] read under the lock (for
+/// [`sync_dir_entries`]).
+///
+/// On a failed write the file is cut back to the end of the last record this
+/// call wrote in full, so a half-written record never sits in front of later
+/// appends while the batch's whole records stay replayable (as the text tier
+/// kept every whole line it had written). The call still returns the error,
+/// so the caller counts the batch as not landed and marks its range
+/// unapplied; a row then reaching QuestDB twice (refold and replay) upserts
+/// onto itself under the depth DEDUP key. If the cut-back also fails, a coded
+/// `error!` names the file; the replay's resync sets the fragment aside later.
+///
+/// Never syncs: the lock must never be held across an fsync, or the drain's
+/// inline fallback could wait on another appender's disk flush.
+///
+/// # Errors
+///
+/// A single line longer than [`FRAMED_MAX_PAYLOAD`] (refused before any
+/// byte is written), or any open, `fstat` or write error.
+pub(crate) fn append_v1_records(
+    path: &Path,
+    payload: &[u8],
+    seq: (u64, u64),
+) -> io::Result<(File, DirSyncTicket)> {
+    let ranges = crate::tick_spill_replay::ilp_chunk_ranges(payload, FRAMED_MAX_PAYLOAD);
+    if ranges.iter().any(|r| r.len() > FRAMED_MAX_PAYLOAD) {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "a depth ILP line is longer than one framed record; refusing before any byte \
+             is written",
+        ));
+    }
+    let headers = build_v1_headers(payload, &ranges, seq);
+    let dir = path.parent().unwrap_or_else(|| Path::new("."));
+    let guard = append_lock();
+    let ticket = DirSyncTicket {
+        file_entry: !guard.is_synced(path),
+        dir_entry: !guard.is_synced(dir),
+        removals: guard.removals,
+    };
+    let mut file = std::fs::OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(path)?;
+    let start = file.metadata()?.len();
+    let mut whole: u64 = 0;
+    let written = write_with_test_hooks(&mut file, payload, &ranges, &headers, &mut whole);
+    if let Err(err) = written {
+        let keep = start + whole;
+        if let Err(cut_err) = cut_back(&file, keep) {
+            error!(
+                code = ErrorCode::HotPath02WriterQueueDrop.code_str(),
+                source = "depth_framed_cut_back_failed",
+                path = %path.display(),
+                start,
+                keep,
+                %cut_err,
+                write_error = %err,
+                "a depth spill write failed part-way and the file could not be cut back \
+                 to its last whole record. The partial record stays in the file; the \
+                 spill replay recognises it by its checksum and sets it aside in \
+                 quarantine, so later records still replay. The batch's whole records \
+                 stay and replay; the caller still counts the batch as not landed."
+            );
+        }
+        return Err(err);
+    }
+    drop(guard);
+    Ok((file, ticket))
+}
