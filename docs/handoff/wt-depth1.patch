+/// Opens `path`'s parent directory and syncs it, so `path`'s directory entry
+/// survives a power loss. Cold: through [`sync_dir_entries`], once per spill
+/// file and once for the spill directory per process, on the synced (writer
+/// and rescue thread) paths only.
+///
+/// # Errors
+///
+/// The open or sync error.
+pub(crate) fn sync_parent_dir(path: &Path) -> io::Result<()> {
+    #[cfg(test)]
+    test_hooks::DIR_SYNCS.with(|c| c.set(c.get() + 1));
+    let parent = path.parent().unwrap_or_else(|| Path::new("."));
+    File::open(parent)?.sync_all()
+}
+
+/// The framed spill files in `dir` (top level only), oldest first by name,
+/// which encodes the hour. A missing directory is empty.
+#[must_use]
+pub fn list_framed_spill_files(dir: &Path) -> Vec<PathBuf> {
+    let Ok(entries) = std::fs::read_dir(dir) else {
+        return Vec::new();
+    };
+    let mut files: Vec<PathBuf> = entries
+        .filter_map(std::result::Result::ok)
+        .map(|e| e.path())
+        .filter(|p| {
+            p.is_file()
+                && p.extension()
+                    .is_some_and(|ext| ext.eq_ignore_ascii_case(DEPTH_FRAMED_SPILL_EXTENSION))
+        })
+        .collect();
+    files.sort();
+    files
+}
+
+/// Counter of framed-spill bytes the replay set aside to quarantine, by
+/// reason. Diagnostic, outside the loss groups: the rows are kept on disk and
+/// uploaded, and the row count also lands on
+/// `tv_tick_spill_replay_lines_rejected_total{dir}`.
+pub const FRAME_SET_ASIDE_BYTES_COUNTER: &str = "tv_depth_spill_frame_set_aside_bytes_total";
+
+/// Seeds [`FRAME_SET_ASIDE_BYTES_COUNTER`] at zero on every reason, so the
+/// first set-aside is a visible delta.
+pub fn register_frame_baseline() {
+    for reason in [
+        "corrupt",
+        "torn_tail",
+        "unsupported",
+        "wrong_table",
+        "refused",
+    ] {
+        metrics::counter!(FRAME_SET_ASIDE_BYTES_COUNTER, "reason" => reason).increment(0);
+    }
+}
+
+/// Test-only knobs: inject a write failure part-way, a cut-back failure, and
+/// count directory syncs. Thread-local, so parallel tests do not see each
+/// other's injections.
+#[cfg(test)]
+pub(crate) mod test_hooks {
+    use std::cell::Cell;
+    use std::io::{self, Write};
+
+    thread_local! {
+        /// The next append fails after writing this many bytes.
+        pub(crate) static FAIL_WRITE_AFTER: Cell<Option<usize>> = const { Cell::new(None) };
+        /// The next cut-back fails.
+        pub(crate) static FAIL_CUT_BACK: Cell<bool> = const { Cell::new(false) };
+        /// Directory syncs on this thread.
+        pub(crate) static DIR_SYNCS: Cell<usize> = const { Cell::new(0) };
+    }
+
+    pub(crate) struct FailingWriter<'a, W> {
+        pub(crate) inner: &'a mut W,
+        pub(crate) left: usize,
+    }
+
+    impl<W: Write> Write for FailingWriter<'_, W> {
+        fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+            if self.left == 0 {
+                return Err(io::Error::other("injected write failure"));
+            }
+            let n = buf.len().min(self.left);
+            let written = self.inner.write(&buf[..n])?;
+            self.left -= written;
+            Ok(written)
+        }
+        fn flush(&mut self) -> io::Result<()> {
+            self.inner.flush()
+        }
+    }
+}
+
+/// The concatenated payloads of every whole record in `path`, in order;
+/// corrupt bytes and a torn tail are skipped. Test helper for the writer
+/// tests.
+#[cfg(test)]
+pub(crate) fn framed_payloads(path: &Path) -> Vec<u8> {
+    let bytes = std::fs::read(path).unwrap_or_default();
+    let mut window = vec![0_u8; bytes.len().max(FRAME_HEADER_BYTES + FRAMED_MAX_PAYLOAD)];
+    let len = bytes.len() as u64;
+    let mut cursor = FramedCursor::new(std::io::Cursor::new(bytes), 0, len, &mut window);
+    let mut out = Vec::new();
+    while let Ok(Some(span)) = cursor.next_span() {
+        if let SpanKind::Record(_) = span.kind {
+            out.extend_from_slice(
+                &cursor.window()[span.range.start + FRAME_HEADER_BYTES..span.range.end],
+            );
+        }
+        cursor.consume(&span);
+    }
+    out
+}
