+// ---------------------------------------------------------------------------
+// Plan item 49d-1 (2026-10-06): the framed depth spill (`.ilpf`) has its own
+// replay, so it is a second spill path that can POST rows to QuestDB. It must
+// filter every kind-1 record on the ARRIVAL clock (the depth writer's clock)
+// and POST only what the filter kept.
+// ---------------------------------------------------------------------------
+
+#[test]
+fn framed_replay_filters_every_kind1_record_on_the_arrival_clock() {
+    let path =
+        std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("src/depth_spill_framed_replay.rs");
+    let raw = std::fs::read_to_string(&path)
+        .unwrap_or_else(|e| panic!("cannot read {}: {e}", path.display()));
+    let src = strip_rust_comments(&raw);
+    let tests_at = src.find("\nmod tests {").unwrap_or(src.len());
+    let production = &src[..tests_at];
+    let call = "retain_lines_in_open_window(payload, true)";
+    let call_at = production.find(call).unwrap_or_else(|| {
+        panic!(
+            "the framed depth replay no longer filters each record with `{call}`; \
+             without it a spilled row the depth writer refused is posted anyway, and \
+             a `false` clock would delete late depth rows the writer kept"
+        )
+    });
+    let after = &production[call_at..];
+    let post_at = after
+        .find("client.post(url)")
+        .expect("the framed replay POSTs after filtering");
+    let between = &after[..post_at];
+    assert!(
+        between.contains("kept.is_empty()"),
+        "an all-refused record must not be sent as an empty body"
+    );
+    assert!(
+        between.contains("bytes::Bytes::from(kept)"),
+        "the POST body must be the FILTERED bytes, not the raw payload"
+    );
+    assert!(
+        after[post_at..].starts_with("client.post(url).body(sent"),
+        "the POST must send the filtered `sent` body"
+    );
+}
