# =============================================================================
# tickvault — systemd Service Unit
# =============================================================================
# Auto-restarts the trading app on crash. Watchdog kills hung processes.
#
# Install:
#   sudo cp deploy/systemd/tickvault.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable tickvault
#   sudo systemctl start tickvault
#
# Check:
#   systemctl status tickvault
#   journalctl -u tickvault -f
# =============================================================================

[Unit]
Description=tickvault — Live F&O Trading System
Documentation=https://github.com/SJParthi/tickvault
After=network-online.target docker.service
Wants=network-online.target docker.service

# Crash-loop safety net (interaction-audit MED — "crash-loop hides under a
# stale gauge"). Restart=always (below) is correct for a genuine one-off crash
# AFTER READY=1, but WITHOUT a start-rate limit a fast crash-loop (e.g. a
# post-READY panic that reproduces on every restart) would restart FOREVER,
# every ~3s, silently. The observability trap: metrics-exporter-prometheus
# re-renders the boot gauges' last value on each scrape while the process is
# briefly alive between restarts, so a crash-loop can keep re-publishing a
# STALE-looking healthy gauge and never surface as a hard failure.
#
# StartLimit* makes that crash-loop OBSERVABLE: > StartLimitBurst restarts
# within StartLimitIntervalSec transitions the unit to `failed` (queryable via
# `systemctl status` / `systemctl is-failed` / an SSM check), which STOPS the
# restart churn and STOPS the stale-gauge re-publish — the app is then genuinely
# dead, its metrics go MISSING, and the market-hours liveness alarm (added in
# this PR) pages.
#
# Values: > 8 restarts in 10 min → `failed`. A healthy slow first boot is ONE
# start attempt that runs long (guarded by TimeoutStartSec=infinity below), NOT
# repeated restarts, so this never trips a legitimate boot. These directives are
# placed in [Unit] (NOT [Service]) per modern systemd — they govern the unit's
# start-rate, unlike Restart=/RestartSec= which live in [Service].
#
# ⚠ WIDENED 2026-09-03 — the 10-minute window could not see a SLOW loop, and a
# slow loop is the one that actually happened.
#
# The arithmetic the old pair encoded: `failed` needs > 8 restarts inside
# StartLimitIntervalSec, so ANY cycle at or above 600/8 = 75 seconds never
# trips it, no matter how many times it repeats. That is not a corner case —
# it is the normal shape of a memory-driven loop, where the process spends
# minutes climbing before it is killed.
#
# MEASURED 2026-09-03: the app crash-looped from 08:31 to 09:02 IST on ~9-minute
# cycles (RSS climbing to 20.96 GB, watchdog kill, restart, repeat). Four full
# cycles. `StartLimitBurst` NEVER FIRED, because 540s > 75s. The unit reported
# `active (running)` throughout, and the loop was found by reading an RSS chart,
# not by anything systemd said.
#
# New pair: > 5 restarts in 60 min → `failed`, which catches any cycle under
# 3600/5 = 720 seconds. Today's ~540s loop trips on the sixth restart, roughly
# 45 minutes in.
#
# The burst comes DOWN 8 → 5, deliberately. Raising the window alone would have
# left the trip point at 3600/8 = 450s — still under today's 540s cycle, i.e. a
# change that reads like a fix and would not have caught the incident that
# motivated it.
#
# What this COSTS, stated rather than absorbed: `failed` means the app is DOWN
# and stays down until someone starts it. That is the intended trade and it is
# not a comfortable one. A looping app captures no ticks anyway AND churns the
# disk that caused the loop, so the choice is between "down and paging" and
# "down and silent". The existing market-hours liveness alarm pages on the
# missing metrics either way; `failed` additionally stops the churn.
StartLimitIntervalSec=3600
StartLimitBurst=5

[Service]
Type=notify
# Run as ec2-user (Amazon Linux 2023 default unprivileged account).
# /opt/tickvault is chowned to ec2-user in the user-data script.
User=ec2-user
Group=ec2-user
# The app binary, dropped by the deploy-aws GitHub Actions workflow.
ExecStart=/opt/tickvault/bin/tickvault
WorkingDirectory=/opt/tickvault

# Self-heal: ensure the QuestDB container EXISTS + is started before the app
# boots. user-data's first-boot `docker compose up -d` runs only once
# (cloud-init), and Docker's `restart: unless-stopped` cannot recreate a
# container that was removed (down/wipe/reset). Without this, a missing QuestDB
# makes the app crash-loop forever on BOOT-02.
#
# This calls scripts/ensure-questdb.sh (idempotent) instead of a bare
# `docker compose ... up -d questdb`, which had THREE bugs (incident 2026-06-08):
#   (a) hosts without the `docker compose` v2 plugin → no-op (docker prints help);
#   (b) the compose SERVICE name is `tv-questdb`, not `questdb`;
#   (c) a recreate needs QDB_PG_* creds from SSM, absent from this unit's env.
# The helper handles running/stopped/removed, tries compose v2→v1→plugin-path,
# and falls back to `docker run` so the box recovers even with no compose.
# Leading `-` = a transient hiccup does NOT hard-fail the unit; the app's own
# 60s `wait_for_questdb_ready` is the real gate.
# NOTE: still does NOT fix QuestDB CRASHING on start (disk-full / volume
# corruption) — see docs/runbooks/aws-docker-daemon-dead.md (`docker logs
# tv-questdb` + `df -h`).
ExecStartPre=-/bin/bash /opt/tickvault/repo/scripts/ensure-questdb.sh

# Boot can legitimately exceed systemd's default 90s TimeoutStartSec: the app
# is Type=notify and only sends READY=1 AFTER its own boot gates complete —
# QuestDB readiness (BOOT-01/BOOT-02), then the infinite-retry daily-universe
# cold build (CSV fetch + NTM resolve + ~767-row lifecycle reconcile). On the
# first-of-day cold boot that whole chain routinely runs past 90s, so the
# default timer would SIGTERM a healthy boot mid-build, producing a crash-loop.
# The app's OWN gates decide boot failure (they HALT + page on a real fault);
# systemd's blunt 90s timer must not pre-empt them. Restart=always (below) still
# restarts a genuine crash that happens AFTER READY=1.
TimeoutStartSec=infinity

# Auto-restart on ANY failure. RestartSec prevents tight restart loops.
# Bounded by StartLimitIntervalSec/StartLimitBurst in [Unit]: after > 8
# restarts in 10 min the unit goes to `failed` and stops restarting (so a true
# crash-loop becomes an observable hard failure instead of an infinite silent
# churn under a re-emitted stale gauge). Recover a `failed` unit manually with
# `systemctl reset-failed tickvault && systemctl start tickvault`.
Restart=always
RestartSec=3

# Watchdog: app must call sd_notify(WATCHDOG=1) every 30s
# (boot_helpers::WATCHDOG_INTERVAL_SECS, pinned by a build-time assertion).
#
# ⚠ RAISED 2026-09-03, 60 → 150 seconds. This directive KILLED THE APP on a
# process that was alive, working, and losing nothing.
#
# At 60s the margin was exactly ONE missed ping. A 30-second interval inside a
# 60-second deadline tolerates no slow cycle at all: the beacon has to be
# scheduled, and win, twice in a row, forever. Under `MemoryHigh` throttling —
# 371,828 throttle events measured on 2026-09-03 — the kernel is deliberately
# slowing allocation, the beacon task loses its slot, the second ping is late,
# and systemd SIGABRTs a process whose only fault was being throttled.
#
# That is the wrong instrument for the job. The watchdog exists to catch a HUNG
# process, not a SLOW one, and a throttled process is slow by design — the
# throttle is the system working. Killing it converts a recoverable pressure
# event into a restart loop, and the restart re-reads the same backlog that
# caused the pressure.
#
# 150s = five ping intervals, so four consecutive pings must be missed before a
# kill. A genuinely hung process still dies, 90 seconds later than before; a
# throttled one now survives its bad minute. Detection latency traded for not
# killing healthy work, which is the right direction on a feed whose mandate is
# to lose nothing.
#
# It stays well under TimeoutStopSec=145 + the deploy watchdog's own window, so
# nothing downstream re-times against it.
WatchdogSec=150

# Environment
Environment=RUST_LOG=info
# TV_ENVIRONMENT selects BOTH config/<env>.toml AND the /tickvault/<env>/ SSM
# prefix (read by boot_helpers::resolve_config_env + secret_manager).
# Single real env (operator 2026-06-30): prod. dev/staging configs were retired;
# base.toml + production.toml are the only env configs. This is STILL the
# no-real-orders data-pull phase — production.toml LOCKS dry_run=true (NO real
# orders) plus a far-future sandbox_only_until belt-and-suspenders. Flipping to
# live trading is a separate, deliberate change (set dry_run=false +
# mode=live AND re-register the static EIP). See config/production.toml.
Environment=TV_ENVIRONMENT=prod
# AWS SDK credentials: pin the default provider chain straight to the EC2
# instance-profile (IMDS) credentials — the ONLY intended credential source on
# the box (SSM reads, and the CloudWatch metrics pipeline that fills the
# Tickvault/Prod namespace).
#
# Root cause (live incident 2026-07-02): this unit hardens with
# ProtectHome=true (below), which masks /home for the service. The AWS SDK's
# default profile-file probe of ~/.aws/config + ~/.aws/credentials
# (HOME=/home/ec2-user under User=ec2-user) therefore fails with EACCES and
# logs "failed to read config file ... Permission denied" on every boot.
# On the pinned Rust SDK (aws-runtime 1.7.5, src/env_config/source.rs — the
# "default config/credentials files MUST NOT return an error" arm) that is a
# warn-and-treat-as-empty, but the probe is pure noise/ambiguity, and every
# CHILD process this unit spawns (e.g. the Groww sidecar's boto3) inherits
# this environment with its own, stricter, profile-file handling. Pointing
# both files at /dev/null removes the unreadable-file probe entirely: the
# chain resolves env -> (empty profile) -> IMDS instance profile
# deterministically, with zero dependency on any on-disk ~/.aws state.
Environment=AWS_CONFIG_FILE=/dev/null
Environment=AWS_SHARED_CREDENTIALS_FILE=/dev/null
# GROWW_MAX_SUBSCRIBE caps the first-run Groww subscription set. Default in code
# is 60 (subset-safe); set to 1000 here to subscribe the FULL ~779-instrument
# Groww universe (NTM-union: indices + F&O underlyings + NIFTY-Total-Market
# constituents). The builder clamps to GROWW_MAX_SUBSCRIPTIONS=1000 (a max, not
# a floor — a prefix-take, indices-first then token-ascending), so 1000 cleanly
# covers the live ~779 count with headroom. Per .claude/rules/project/
# groww-second-feed-scope-2026-06-19.md.
Environment=GROWW_MAX_SUBSCRIBE=1000
# TICKVAULT_DHAN_LIVE_FEED is the SECOND of the two gates on the Dhan live
# WebSocket lane; `[feeds] dhan_enabled = true` in config is the first, and
# `spawn_dhan_feed_stack` requires BOTH. Set to 1 here on 2026-08-11 per the
# operator quote recorded in websocket-connection-scope-lock.md ("2026-08-11 —
# THE DEFAULT IS FLIPPED ON").
#
# It lives HERE and not in the config on purpose: the config file is shared
# with every developer checkout, so a config-only flip would open sockets on
# a laptop running `cargo run`. Scoping the second gate to the deployed unit
# means the lane goes live on the box and stays dark everywhere else — the
# same reason TV_ENVIRONMENT is set here rather than defaulted in code.
#
# Turning it off is the fastest rollback available: comment this line, then
# `systemctl daemon-reload && systemctl restart tickvault`. No rebuild, no
# deploy, no config edit — the gate is read at boot.
Environment=TICKVAULT_DHAN_LIVE_FEED=1

# ---------------------------------------------------------------------------
# CPU confinement (operator Quote 17b, 2026-08-19 — CPU isolation)
# ---------------------------------------------------------------------------
#
# The box is r8g.xlarge: 4 vCPU, Graviton4, NOT burstable. Before this, three
# tenants each believed they owned all four cores — this app's tokio runtime
# defaulted to `worker_threads = num_cpus = 4`, QuestDB held a 3.0 CPU quota
# with no cpuset, and NIC softirq landed wherever the kernel put it. Measured
# consequence on 2026-08-18: 21.8% of QuestDB's scheduling periods throttled
# (nr_throttled 18,594 / nr_periods 85,149).
#
# The partition, whose other halves live in deploy/docker/docker-compose.yml
# (QuestDB + sidecars) and deploy/aws/host-tuning/apply-host-tuning.sh (IRQs):
#
#   core 0  OS + NIC IRQ/softirq + the log sidecars
#   core 1  THIS PROCESS — exclusive
#   core 2  shared burst: this process + QuestDB
#   core 3  QuestDB — exclusive
#
# WHY NOT CORE 0. Core 0 services network softirq. Pinning the tick decoder
# there would put it in direct contention with the very work that delivers its
# packets — CLAUDE.md records this explicitly, and it is the reason the app's
# set starts at 1 rather than 0.
#
# WHY `AllowedCPUs=` AND NOT `CPUAffinity=`. AllowedCPUs writes the unit's
# cgroup-v2 `cpuset.cpus`, which is the exact same mechanism docker uses for
# QuestDB — one concept, two tenants, symmetric and inspectable in the same
# place. It is also the fail-SAFER of the two: if the cpuset controller is
# unavailable systemd logs and carries on, whereas a CPUAffinity whose CPUs do
# not exist can make sched_setaffinity fail and take the START with it. A host
# with an untuned scheduler is slower; a host with no app is blind.
#
# HOST-SIZE SAFETY. This names CPUs 1-2, which requires at least 3 cores. On a
# smaller host the tuning unit REMOVES this setting via a drop-in before the
# app starts (see apply-host-tuning.sh) rather than letting it pin the app
# into a set the kernel cannot honour.
#
# ROLLBACK — no code change, no rebuild, no redeploy:
#   printf '[Service]\nAllowedCPUs=\n' \
#     > /etc/systemd/system/tickvault.service.d/99-cpu-rollback.conf
#   systemctl daemon-reload && systemctl restart tickvault
# An EMPTY assignment resets the list, restoring all-cores behaviour. Reverting
# this file in git and redeploying achieves the same thing.
AllowedCPUs=1-2

# Runtime width, read by main.rs. Must stay CONSISTENT with AllowedCPUs above:
# more workers than allowed cores buys context switches, not throughput. The
# app's own default is 2 (main.rs `DEFAULT_TOKIO_WORKER_THREADS`); this line
# states it where an operator changing the core set will see it.
# ROLLBACK to the pre-2026-08-19 `num_cpus` behaviour on this box: set 4.
Environment=TICKVAULT_TOKIO_WORKER_THREADS=2

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# ---------------------------------------------------------------------------
# Memory ceiling + OOM ranking (2026-09-02 — second-sweep finding 5)
# ---------------------------------------------------------------------------
#
# Until this block the unit set NO memory directive of any kind. Two things
# followed from that, and both were measured in source rather than assumed:
#
#   1. The kernel OOM killer ranks by RSS, and this process is the largest
#      RSS on the box after QuestDB. QuestDB's container already carries
#      `oom_score_adj: -500` (deploy/docker/docker-compose.yml), so under
#      host memory exhaustion the kernel would kill THIS process FIRST.
#      That is the wrong order: QuestDB is recoverable — a stalled or
#      restarted database is absorbed by the tick/depth spill tier and
#      re-ingested — while this process is the ONLY tick capture path, and
#      an upstream tick that arrives while it is dead is never resent.
#   2. RESOURCE-02 (the process's own memory early warning,
#      crates/storage/src/resource_monitor.rs) resolves its ceiling from the
#      cgroup, and with no directive here the cgroup reports `max`, so the
#      80% line it watched was 80% of the whole machine — unreachable
#      before the kernel acts.
#
# OOMScoreAdjust=-900 puts this process BELOW QuestDB (-500) in the kill
# order, so exhaustion takes the recoverable tenant first. It does not make
# the process unkillable (-1000 would); the kernel still reclaims it last.
#
# MemoryHigh=20G is a THROTTLE, not a kill: past it the kernel reclaims this
# cgroup aggressively and slows allocation, and RESOURCE-02 has a reachable
# ceiling to page against. There is deliberately NO `MemoryMax=` — a hard
# cap turns a memory spike into an OOM kill of the one process whose death
# loses ticks, which is exactly the outcome the ranking above exists to
# avoid. Throttle and page, never kill.
#
# WHY 15G. Host usable RAM (MemTotal on the r8g.xlarge, 32 GiB nominal) is
# ~31.3 GiB. Committed to other tenants: QuestDB hard cap 12.5 GiB
# (`mem_limit: ${QDB_MEM_LIMIT:-12g}` + `shm_size: 512m`, docker-compose.yml)
# + sidecars ~0.64 GiB (tv-alloy 384m + tv-loki 256m) + an OS/page-cache
# floor of 2–4 GiB. That leaves ~14.2–16.2 GiB for this process. Its
# measured working-set envelope is 4.3–11.2 GB (the subsystem-memory gauges),
# so 15 GiB sits ABOVE the envelope — a healthy session never touches it —
# and BELOW host exhaustion, so the throttle engages before the kernel does.
# AL2023 runs with no swap, so "before swap" and "before OOM" are the same
# line here; the throttle is the only soft stop that exists.
#
# ONE COPY. deploy/aws/terraform/user-data.sh.tftpl installs this file with
# a plain `cp` from the repo checkout (verified: it is not templated), so
# there is no second copy of the unit to drift from this one.
#
# ROLLBACK — no code change, no rebuild, no redeploy:
#   printf '[Service]\nMemoryHigh=infinity\nOOMScoreAdjust=0\n' \
#     > /etc/systemd/system/tickvault.service.d/99-memory-rollback.conf
#   systemctl daemon-reload && systemctl restart tickvault
# `MemoryHigh=infinity` removes the throttle; `OOMScoreAdjust=0` restores the
# kernel's default ranking. Reverting this file in git and redeploying
# achieves the same thing.
OOMScoreAdjust=-900
# RAISED 15G -> 20G on 2026-09-03, operator-approved, after a live incident.
#
# WHAT HAPPENED: a 21 GB depth spill file was read WHOLE into memory by the
# recovery drain (`tick_spill_replay`, since fixed to stream). Process RSS hit
# 20.96 GiB. The kernel then reclaimed so aggressively that the watchdog
# beacon could not deliver its 30-second ping inside `WatchdogSec=60`, and
# systemd SIGABRTed a process that was alive and working -- once every ~9
# minutes, all session. `oom_kill` stayed 0 throughout: this was never an OOM.
#
# The ~9-minute cycle also slips the [Unit] start limit: 8 starts per 600 s
# means any cycle >= 75 s never trips it, so the unit loops forever instead of
# transitioning to `failed` where an alarm could see it.
#
# WHY 20G AND NOT MORE: the measured steady working set is 0.29-1.54 GiB in
# session and ~15.6 GiB during a large replay. The host has ~30 GiB with
# QuestDB capped at 12 GiB, so 20G leaves the host a real margin. Raising
# further would trade a cgroup throttle for a HOST OOM, where the kernel
# picks the victim -- and QuestDB's oom_score_adj of -500 makes this process
# a worse target than it looks despite OOMScoreAdjust=-900 below.
#
# THIS VALUE IS LOAD-BEARING AND MUST STAY IN THE REPOSITORY. It was applied
# live as a systemd drop-in first; a drop-in is an EXTENSION, not an override,
# so `systemd-delta` reports nothing and the drift is invisible. A fresh
# instance provisioned from this file at 15G re-enters the SIGABRT loop.
#
# NOTE, because it is not obvious: this ceiling is not only a throttle. With
# no `MemoryMax=`, `resolve_memory_ceiling` resolves the unit's ceiling FROM
# `memory.high`, so raising it also raised the WAL catch-up stand-down (60%
# => 12.88 GB) and the RESOURCE-02 page line (80% => 17.18 GB). Changing this
# number moves those with it.
MemoryHigh=20G

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# Docker socket exemption (2026-07-13, deploy-hang fix companion):
# ProtectSystem=strict mounts the whole hierarchy read-only (except
# /dev /proc /sys), and connect(2) on a unix socket needs WRITE access to the
# socket inode — so every `docker …` call made by ExecStartPre
# (ensure-questdb.sh) fails with EACCES in the SERVICE-USER context while the
# SAME script works from an SSM/root shell (no sandbox). On a post-nuke boot
# with no QuestDB container/image that meant the self-heal could never bring
# QuestDB up → BOOT-02 halt at 08:30. The `-` prefix ignores a missing socket
# (docker.service not yet up), so this can never fail the unit start; it only
# widens the sandbox by the docker control socket (ec2-user is already in the
# docker group — no privilege change). /var/run is a /run symlink; both listed
# so the exemption holds regardless of which path the CLI resolves.
ReadWritePaths=/opt/tickvault/data /opt/tickvault/config -/var/run/docker.sock -/run/docker.sock
PrivateTmp=true

# Graceful shutdown: send SIGTERM, wait, then SIGKILL.
#
# MEASURED AND RAISED 2026-08-21 (was 30s, which SIGKILLed the day's tail).
# The app's shutdown path runs FOUR bounded waits SEQUENTIALLY:
#
#   DHAN_LANE_SHUTDOWN_FLUSH_BUDGET_SECS   = 30   (lane flush, runs first)
#   SEAL_WRITER_SHUTDOWN_BUDGET_SECS       = 75   (final seal drain, second)
#   SEAL_ESCALATION_SHUTDOWN_BUDGET_SECS   = 5    (escalation queue, third)
#   WAL_SPILL_SHUTDOWN_BUDGET_SECS         = 10   (WAL queue drain, fourth)
#   worst case                             = 120s
#
# Three live in crates/app/src/main.rs; WAL_SPILL_SHUTDOWN_BUDGET_SECS lives
# in crates/storage/src/ws_frame_spill.rs and is reached through
# WsFrameSpill::shutdown.
#
# At 30s the seal writer could receive at most 10s of its 75s budget, and at
# the measured ~10,200 seals/sec that drains ~102,000 of a possible 600,000
# seals at the 25,000-instrument ceiling — the rest, INCLUDING every
# instrument's final daily bar, died on SIGKILL. The 75s constant was sized
# from a live drain-rate measurement on 2026-08-20 and its own comment warns
# that "overrunning systemd's stop timeout earns a SIGKILL, which loses the
# very tail this exists to save" — the two files had simply drifted, with
# nothing pinning them together.
#
# 145 = the 120s worst case + 25s margin. Raising it is fail-SAFE: it only
# ever grants more time, never less. The daily 17:30 IST auto-stop is
# unaffected — a 115s shutdown completes by ~17:31:55, and the stop-verify
# lambda does not fire until 17:45 IST.
#
# 2026-08-28: 120 -> 130, because the lane budget went 20s -> 30s to cover
# the spawn-failure fallback, where the tail flushes depth AND ticks
# synchronously (5s + 5s of ILP timeout) BEFORE the 12s join deadline even
# starts. The guard below caught the overrun; the note that raised the lane
# budget claimed 30s was "still far inside TimeoutStopSec=120" and was WRONG
# — a .service file is invisible to the compile-time assert in main.rs, and
# that is exactly the blind spot this test exists to cover. Fix applied in
# the direction the guard prescribes: raise the timeout, never shrink a drain
# budget that was sized from a real failure mode.
#
# 2026-08-28 (same day, second raise): 130 -> 140, because a THIRD bounded
# wait joined the path — WAL_SPILL_SHUTDOWN_BUDGET_SECS. Until then the WAL
# spill writer thread was DETACHED: nothing joined it, nothing could signal
# it, and the process exited while up to 524,288 captured frames sat unwritten
# in its queue, counted by nothing. The drain that closes that hole is a
# fourth thing competing for this timeout, so the timeout moved with it.
#
# 2026-08-28 (same day, third raise): 140 -> 145, because a FOURTH bounded
# wait joined the path — SEAL_ESCALATION_SHUTDOWN_BUDGET_SECS. Refused seals
# used to write to disk INLINE on the frame-drain task (a spill mutex plus a
# write(2), and on spill failure a create_dir_all, an open, a JSON heap
# allocation and four more syscalls) — on the one thread that empties the
# socket, which is how ticks are lost UPSTREAM at a vendor that skips slow
# consumers forward with no sequence number. Moving that to a dedicated
# thread creates a bounded queue, and a bounded queue that is not drained at
# exit is the same silent loss the WAL raise above closed. The margin stays
# 25s rather than narrowing to 20s: the guard permits 20 but calls it the
# floor, and the teardown after the drain (API + otel shutdown, partition
# detach) is what spends it.
#
# Pinned by crates/app/tests/shutdown_budget_fits_systemd_guard.rs — the
# relationship, not the number: raising any app budget past this timeout
# now fails the build.
TimeoutStopSec=145
KillMode=mixed
KillSignal=SIGTERM

# Logging to journald (also captured by Alloy → Loki if configured)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tickvault

[Install]
WantedBy=multi-user.target
