{
  "agent": { "metrics_collection_interval": 60 },
  "metrics": {
    "metrics_collected": {
      "disk": { "measurement": ["used_percent"], "resources": ["/"] }
    },
    "append_dimensions": { "InstanceId": "${aws:InstanceId}" }
  },
  "logs": {
    "metrics_collected": {
      "prometheus": {
        "prometheus_config_path": "/opt/aws/amazon-cloudwatch-agent/etc/prometheus.yaml",
        "log_group_name": "/tickvault/prod/metrics",
        "emf_processor": {
          "metric_namespace": "Tickvault/Prod",
          "metric_declaration_dedup": true,
          "metric_declaration": [
            {
              "source_labels": ["host"],
              "label_matcher": "^tickvault-prod$",
              "dimensions": [["host"]],
              "metric_selectors": ["^(tv_questdb_disconnected_seconds|tv_token_remaining_seconds|tv_boot_completed|tv_daily_pnl|tv_questdb_wal_suspended_tables|tv_wal_replay_corrupted_segments_total|tv_order_audit_rows_discarded_total|tv_order_audit_chain_lost_total|tv_order_audit_persist_errors_total|tv_order_update_events_dropped_total|tv_order_update_events_persist_errors_total|tv_order_update_events_rows_discarded_total|tv_spill_dir_free_bytes|tv_dhan_ws_wal_dropped_total|tv_dhan_ws_ring_full_total|tv_dhan_ws_ring_bytes_full_total|tv_ticks_dropped_total|tv_tick_persist_errors_total|tv_tick_rows_refused_total|tv_ws_frame_spill_write_errors_total|tv_dhan_feed_stack_up|tv_dhan_ws_park_total|tv_ticks_lost_total|tv_ws_frame_spill_drop_critical|tv_dhan_live_universe_fallback_total|tv_dhan_ws_alive_connections|tv_ws_frame_wal_reinjected_dropped_total|tv_dhan_contract_universe_failed_total|tv_dhan_feed_last_tick_age_secs|tv_depth_rows_dropped_total|tv_depth_persist_errors_total|tv_ilp_rows_discarded_total|tv_ticks_spilled_total|tv_wal_replay_unknown_magic_total|tv_aggregator_slot_exhausted_total|tv_seal_writer_drain_dropped_total|tv_depth_rows_spilled_total|tv_tick_spill_replay_quarantined_total|tv_offload_writer_shutdown_incomplete_total|tv_tick_rescue_abandoned_total|tv_wal_spill_shutdown_incomplete_total|tv_raw_frame_upload_failed_total|tv_cold_file_upload_failed_total|tv_raw_upload_marker_write_failed_total|tv_order_update_broadcast_drops_total|tv_log_lines_dropped_total)$"]
            }
          ]
        }
      }
    },
    "logs_collected": {
      "files": {
        "collect_list": [
          { "file_path": "/opt/tickvault/data/logs/machine/errors.jsonl.2*", "log_group_name": "/tickvault/prod/app", "log_stream_name": "{instance_id}/errors-jsonl", "timestamp_format": "%Y-%m-%dT%H:%M:%S.%f", "timezone": "UTC" },
          { "file_path": "/opt/tickvault/data/logs/machine/app.2*", "log_group_name": "/tickvault/prod/app", "log_stream_name": "{instance_id}/app", "timestamp_format": "%Y-%m-%dT%H:%M:%S.%f", "timezone": "Local" }
        ]
      }
    }
  }
}
