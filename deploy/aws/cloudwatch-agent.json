{
  "agent": { "metrics_collection_interval": 60 },
  "metrics": {
    "metrics_collected": {
      "disk": { "measurement": ["used_percent"], "resources": ["/"] },
      "mem":  { "measurement": ["mem_used_percent"] },
      "cpu":  { "measurement": ["cpu_usage_active"] }
    },
    "append_dimensions": { "InstanceId": "${aws:InstanceId}" }
  },
  "logs": {
    "metrics_collected": {
      "prometheus": {
        "prometheus_config_path": "/opt/aws/amazon-cloudwatch-agent/etc/prometheus.yaml",
        "log_group_name": "/tickvault/prod/metrics",
        "emf_processor": {
          "metric_namespace": "Tickvault/Prod",
          "metric_declaration_dedup": true,
          "metric_declaration": [
            {
              "source_labels": ["host"],
              "label_matcher": "^tickvault-prod$",
              "dimensions": [["host"]],
              "metric_selectors": ["^(tv_questdb_disconnected_seconds|tv_token_remaining_seconds|tv_orders_rejected_total|tv_boot_completed|tv_clock_skew_seconds|tv_disk_watcher_respawn_total|tv_process_rss_bytes|tv_subsystem_memory_estimated_bytes|tv_rest_1m_fire_heartbeat|tv_daily_pnl|tv_spot1m_persist_errors_total|tv_chain1m_persist_errors_total|tv_rest_fetch_audit_persist_errors_total|tv_rest_fetch_audit_rows_discarded_total|tv_chain_mark_refused_total|tv_cadence_ladder_exhausted_total|tv_cadence_boundary_skipped_total|tv_cadence_late_response_total|tv_cadence_runner_respawn_total|tv_cadence_gate_denials_total|tv_cadence_spot_fallback_total|tv_questdb_wal_suspended_tables|tv_questdb_wal_apply_lag_max|tv_questdb_reconnects_total|tv_partition_archive_failed_total|tv_wal_replay_corrupted_segments_total|tv_order_audit_rows_discarded_total|tv_order_audit_persist_errors_total|tv_order_update_events_dropped_total|tv_order_update_events_persist_errors_total|tv_order_update_events_rows_discarded_total|tv_dhan_order_push_respawn_total|tv_spill_dir_free_bytes|tv_open_fds|tv_oom_kills_total|tv_ram_store_dropped_total|tv_ram_store_errors_total|tv_mid_session_profile_rest_degraded_total|tv_boot_deadline_exceeded_total|tv_dhan_ws_wal_dropped_total|tv_dhan_ws_ring_full_total|tv_dhan_ws_ring_bytes_full_total|tv_dhan_ws_frame_refused_total|tv_dhan_ws_subscribe_failed_total|tv_dhan_feed_seals_dropped_total|tv_dhan_feed_seals_emitted_total|tv_dhan_feed_seq_refused|tv_dhan_feed_instruments_silent|tv_dhan_feed_instruments_never_ticked|tv_ticks_dropped_total|tv_tick_persist_errors_total|tv_tick_rows_refused_total|tv_ws_frame_spill_write_errors_total|tv_dhan_feed_stack_up|tv_dhan_feed_drain_frames_total|tv_dhan_feed_ingest_ticks_total|tv_dhan_feed_ingest_refused_total|tv_dhan_ws_reconnect_total|tv_dhan_ws_park_total|tv_dhan_ws_dial_failed_total|tv_ticks_lost_total|tv_ws_frame_spill_drop_critical|tv_dhan_feed_stack_connections|tv_dhan_ws_lag_excluded_total|tv_dhan_feed_ring_max_bytes|tv_host_total_ram_bytes|tv_dhan_live_universe_fallback_total|tv_dhan_ws_alive_connections|tv_ws_frame_wal_reinjected_dropped_total|tv_dhan_feed_depth_total|tv_dhan_contract_universe_failed_total|tv_dhan_feed_last_tick_age_secs|tv_depth_rows_dropped_total|tv_depth_persist_errors_total|tv_ilp_rows_discarded_total|tv_ticks_spilled_total|tv_tick_spill_replay_failed_total|tv_wal_suspension_probe_failed_total|tv_candle_session_high_recovered_total|tv_candle_session_low_recovered_total|tv_depth_rebalance_age_secs|tv_dhan_feed_ring_dwell_max_ms|tv_dhan_ws_worst_conn_tick_age_secs|tv_dhan_feed_ring_resident_pct|tv_wal_replay_recovered_total|tv_wal_replay_deferred_segments_total|tv_wal_replay_unknown_magic_total|tv_dhan_wal_refolded_total|tv_aggregator_tick_refused_total|tv_candle_tick_discarded_late_total|tv_aggregator_slot_exhausted_total|tv_dhan_feed_abandoned_bytes_total|tv_seal_writer_drain_dropped_total|tv_depth_rows_spilled_total|tv_depth_spill_write_errors_total|tv_dhan_feed_seals_rescued_total|tv_tick_spill_replay_quarantined_total|tv_wal_catchup_budget_exhausted_total)$"]
            }
          ]
        }
      }
    },
    "logs_collected": {
      "files": {
        "collect_list": [
          { "file_path": "/opt/tickvault/data/logs/machine/errors.jsonl.2*", "log_group_name": "/tickvault/prod/app", "log_stream_name": "{instance_id}/errors-jsonl", "timezone": "UTC" },
          { "file_path": "/opt/tickvault/data/logs/machine/app.2*", "log_group_name": "/tickvault/prod/app", "log_stream_name": "{instance_id}/app", "timezone": "UTC" }
        ]
      }
    }
  }
}
